const gwPrincipal = "gateways.Gateway"

type gwOrg struct {
	tenant string
	admin  gwUser
}

// org creates a tenant whose only member is a verified admin. Membership is
// an explicit trusted SQL assignment, as in production.
func (f *gwFixture) org(t *testing.T, email string) gwOrg {
	t.Helper()

	admin := f.enroll(t, email)
	tenant := "org-" + strings.ToLower(jobs.NewID())

	if _, err := f.admin.Exec(
		t.Context(),
		"INSERT INTO users (org_id, id, role) VALUES ($1, $2, 'admin')",
		tenant,
		admin.id,
	); err != nil {
		t.Fatal(err)
	}

	return gwOrg{tenant: tenant, admin: admin}
}

// create registers a pending gateway through the authored admin operation.
func (f *gwFixture) create(
	t *testing.T,
	org gwOrg,
	name string,
) models.CreatedGateway {
	t.Helper()

	var created models.CreatedGateway

	err := f.app.WithSession(
		t.Context(),
		org.admin.session,
		org.tenant,
		func(ctx context.Context, caller access.Caller) error {
			var err error

			created, err = f.app.Operations.GatewaysCreate.Execute(
				ctx,
				caller,
				models.NewGateway{Name: name},
			)

			return err
		},
	)
	if err != nil {
		t.Fatal(err)
	}

	return created
}

func gwKey(t *testing.T) (ed25519.PrivateKey, string) {
	t.Helper()

	public, private, err := ed25519.GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}

	return private, base64.RawURLEncoding.EncodeToString(public)
}

func (f *gwFixture) enrollGateway(
	token, public string,
) *httptest.ResponseRecorder {
	body, _ := json.Marshal(
		map[string]string{"token": token, "public_key": public},
	)

	return f.call("POST", "/api/gateways/enroll", string(body), "", "")
}

// active creates and enrolls a gateway, returning its id and private key.
func (f *gwFixture) active(
	t *testing.T,
	org gwOrg,
	name string,
) (string, ed25519.PrivateKey) {
	t.Helper()

	created := f.create(t, org, name)
	private, public := gwKey(t)

	response := f.enrollGateway(created.Token, public)
	f.expect(t, response, 200)

	if !strings.Contains(response.Body.String(), created.ID) {
		t.Fatalf("enrollment returned another machine: %s",
			response.Body.String())
	}

	return created.ID, private
}

// signed builds a request signed for the exact body at the given time.
func signed(
	t *testing.T,
	method, target, body string,
	key ed25519.PrivateKey,
	id string,
	at time.Time,
) *http.Request {
	t.Helper()

	request := httptest.NewRequest(method, target, strings.NewReader(body))
	request.Header.Set("Origin", gwOrigin)

	if body != "" {
		request.Header.Set("Content-Type", "application/json")
	}

	if err := transport.SignMachineRequest(
		request,
		[]byte(body),
		key,
		gwPrincipal,
		id,
		at,
	); err != nil {
		t.Fatal(err)
	}

	return request
}

func (f *gwFixture) serve(r *http.Request) *httptest.ResponseRecorder {
	response := httptest.NewRecorder()
	f.app.Handler().ServeHTTP(response, r)

	return response
}

func (f *gwFixture) heartbeat(
	t *testing.T,
	key ed25519.PrivateKey,
	id string,
	seq int,
