package caching

import (
    "context"
    "os"
    "testing"
    "time"

    "example.com/cache-test/internal/config"
    "github.com/plutoframework/pluto-core/cache"
)

func TestGeneratedCache(t *testing.T) {
    settings := config.Cache{Backend: "{{.Mode}}", Environment: "test"}
    if settings.Backend == "valkey" {
        settings.URL = os.Getenv("PLUTO_CLI_CACHE_TEST_URL")
        if settings.URL == "" { t.Skip("real adapter check requires PLUTO_CLI_CACHE_TEST_URL") }
    }
    store, closeCache, err := New(settings)
    if err != nil { t.Fatal(err) }
    defer closeCache()
    ctx := context.Background()
    key, err := cache.Key(cache.Scope{App: "generated-cache-test", Environment: "test", Namespace: "data", Version: "1"}, "value")
    if err != nil { t.Fatal(err) }
    defer store.Delete(ctx, key)
    if err := cache.SetJSON(ctx, store, key, "value", time.Minute); err != nil { t.Fatal(err) }
    value, found, err := cache.GetJSON[string](ctx, store, key)
    if err != nil || found != (settings.Backend != "none") { t.Fatal("cache contract", found, err) }
    if found && value != "value" { t.Fatal(value) }
    if err := store.Delete(ctx, key); err != nil { t.Fatal(err) }
    if _, found, err := store.Get(ctx, key); err != nil || found { t.Fatal("delete failed", err) }
}

func TestCacheConfiguration(t *testing.T) {
    _, err := config.LoadFrom(func(key string) (string, bool) {
        switch key {
        case "CACHE_TEST_CACHE_ALLOW_INSECURE": return "not-a-bool", true
        case "CACHE_TEST_DATABASE_URL": return "postgres://not-connected/example", true
        }
        return "", false
    })
    if err == nil { t.Fatal("invalid cache boolean accepted") }
}
