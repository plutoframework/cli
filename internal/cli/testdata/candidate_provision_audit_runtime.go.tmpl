package app_test

import (
	"testing"
)

func (f *sysFixture) auditCount(
	t *testing.T,
	org, eventType string,
) int {
	t.Helper()

	var count int

	if err := f.admin.QueryRow(
		t.Context(),
		"SELECT count(*) FROM audit_events WHERE org_id = $1 AND type = $2",
		org,
		eventType,
	).Scan(&count); err != nil {
		t.Fatal(err)
	}

	return count
}

// Provisioning appends its first audit row inside the provisioning
// transaction: the row lands in the NEW organization, attributed to the
// verified first admin, and a later failure rolls back org, admin and audit
// row together.
func TestProvisionAuditInTransaction(t *testing.T) {
	f := sysSetup(t)
	alice := f.enroll(t, "alice@example.test")

	acme := f.provision(t, alice, "acme", 200)

	if got := f.auditCount(t, acme.Data.ID, "org.provisioned"); got != 1 {
		t.Fatalf("provision audit rows in the new org = %d, want 1", got)
	}

	var actor string

	if err := f.admin.QueryRow(
		t.Context(),
		"SELECT actor_id FROM audit_events WHERE org_id = $1",
		acme.Data.ID,
	).Scan(&actor); err != nil || actor != alice.id {
		t.Fatalf("audit actor = %q (%v), want the verified subject", actor, err)
	}

	// A failure after the audit append rolls back everything.
	f.provision(t, alice, "rollback", 500)

	var orgs, events int

	if err := f.admin.QueryRow(
		t.Context(),
		"SELECT (SELECT count(*) FROM orgs WHERE slug = 'rollback'), "+
			"(SELECT count(*) FROM audit_events WHERE org_id <> $1)",
		acme.Data.ID,
	).Scan(&orgs, &events); err != nil || orgs != 0 || events != 0 {
		t.Fatalf("rollback left rows: orgs=%d events=%d (%v)", orgs, events, err)
	}

	// Another tenant never sees this tenant's audit rows through RLS.
	bob := f.enroll(t, "bob@example.test")
	beta := f.provision(t, bob, "beta", 200)

	if f.auditCount(t, beta.Data.ID, "org.provisioned") != 1 ||
		f.auditCount(t, acme.Data.ID, "org.provisioned") != 1 {
		t.Fatal("each organization must hold exactly its own provision row")
	}
}
