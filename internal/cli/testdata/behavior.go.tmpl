func TestCollectionParsingAndDetailIntent(t *testing.T) {
 if !paths.ReportsList.Collection || paths.ReportsGet.Collection || paths.WidgetsGet.Collection {t.Fatal("collection intent lost")}
 router:=chi.NewRouter()
 enabled:=true
 reg:=transport.Registrar{Router:router,Auth:trustedAuth{permission:true},Features:features.New(map[string]*bool{"private-report":&enabled}),Policy:publishedPolicy(t),Logger:slog.New(slog.NewTextHandler(io.Discard,nil))}
 operation:=&listReports{}
 reports.RegisterList(reg,operation,16*1024)
 send:=func(query string)*httptest.ResponseRecorder{
  r:=httptest.NewRequest("GET","/api/reports"+query,nil)
  r.Header.Set("Authorization","Bearer trusted")
  r.Header.Set("X-Tenant-ID","member-tenant")
  w:=httptest.NewRecorder();router.ServeHTTP(w,r);return w
 }
 first:=send("?limit=2")
 var body reportmodels.ListResponse
 if err:=json.Unmarshal(first.Body.Bytes(),&body);err!=nil{t.Fatal(err)}
 if first.Code!=200||len(body.Data)!=2||!body.Page.HasMore||body.Page.NextCursor==""||operation.calls!=1{t.Fatal(first,body,operation.calls)}
 for _,query:=range []string{"?limit=101","?limit=1&limit=2","?cursor=bad"}{
  if w:=send(query);w.Code!=400||operation.calls!=1{t.Fatal(w,operation.calls)}
 }
}

func TestMissingDurableIdempotencyFailsClosed(t *testing.T) {
 router:=chi.NewRouter()
 enabled:=true
 operation:=&recordingOperation{}
 reg:=transport.Registrar{Router:router,Auth:trustedAuth{permission:true},Features:features.New(map[string]*bool{"widgets-create":&enabled}),Policy:publishedPolicy(t),Logger:slog.New(slog.NewTextHandler(io.Discard,nil))}
 widgets.RegisterCreate(reg,operation,16*1024)
 r:=httptest.NewRequest("POST","/api/widgets/item-1",strings.NewReader(`{"value":"input"}`))
