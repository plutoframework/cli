type trustedAuth struct { permission bool; unknownRole bool }
func (auth trustedAuth) Authenticate(_ context.Context,token string{{if .Multi}},tenant string{{end}}) (domain.Principal,error) {
 if token!="trusted"{{if .Multi}} || tenant!="member-tenant"{{end}} {
  return domain.Principal{},errors.New("untrusted")
 }
 roles:=[]rbac.RoleID{"viewer"}
 if auth.permission { roles=[]rbac.RoleID{"fixture"} }
 if auth.unknownRole { roles=append(roles,"unknown-role") }
 return domain.Principal{
  ActorID:"actor",
  {{if .Multi}}TenantID:"member-tenant",{{end}}
  Roles: roles,
 },nil
}

type recordingOperation struct { calls int; principal domain.Principal; input widgetmodels.CreateRequest }
func (operation *recordingOperation) Execute(_ context.Context,principal domain.Principal,input widgetmodels.CreateRequest) (widgetmodels.CreateData,error) {
 operation.calls++
 operation.principal=principal
 operation.input=input
 return widgetmodels.CreateData{Value:"recorded"},nil
}

func TestIndependentPolicyMatrix(t *testing.T) {
 for _,test:=range []struct {
  name,token,tenant,body string
  permission,enabled bool
  status,calls int
 }{
  {"auth-first","bad","member-tenant",`{}`,true,true,401,0},
  {"permission","trusted","member-tenant",`{}`,false,true,403,0},
  {"feature","trusted","member-tenant",`{}`,true,false,403,0},
  {"success","trusted","member-tenant",`{"value":"input"}`,true,true,200,1},
  {"unknown-field","trusted","member-tenant",`{"unknown":1}`,true,true,400,0},
  {"invalid-type","trusted","member-tenant",`{"value":42}`,true,true,400,0},
  {"extra-json","trusted","member-tenant",`{} {}`,true,true,400,0},
  {"null","trusted","member-tenant",`null`,true,true,400,0},
  {"oversized","trusted","member-tenant",`{"value":"`+strings.Repeat("x",20000)+`"}`,true,true,413,0},
  {{if .Multi}}{"tenant","trusted","untrusted-tenant",`{}`,true,true,401,0},{{end}}
 } {
  t.Run(test.name,func(t *testing.T) {
   router:=chi.NewRouter()
   operation:=&recordingOperation{}
   evaluator:=features.New(map[string]*bool{"widgets-create":&test.enabled})
   reg:=transport.Registrar{Router:router,Auth:trustedAuth{permission:test.permission},Features:evaluator,Policy:publishedPolicy(t),Logger:slog.New(slog.NewTextHandler(io.Discard,nil))}
   reg.Idempotency=localIdempotency(t)
 widgets.RegisterCreate(reg,operation,16*1024)
   request:=httptest.NewRequest("POST","/api/widgets/item-1",strings.NewReader(test.body))
   request.Header.Set("Authorization","Bearer "+test.token)
 request.Header.Set("Idempotency-Key","fixture-key")
   request.Header.Set("X-Tenant-ID",test.tenant)
   response:=httptest.NewRecorder()
   router.ServeHTTP(response,request)
   if response.Code!=test.status || operation.calls!=test.calls {
    t.Fatalf("status=%d calls=%d body=%s",response.Code,operation.calls,response.Body)
   }
   if test.calls==1 {
    if operation.input.Path["id"]!="item-1" || operation.input.Value!="input" || operation.principal.ActorID!="actor"{{if .Multi}} || operation.principal.TenantID!="member-tenant"{{end}} { t.Fatal("verified scope or route input lost") }
   }
  })
 }
}

func TestResolvedFlagsAndIncompleteOperation(t *testing.T) {
 lookup:=func(name string)(string,bool) {
  if name==config.Prefix+"FEATURE_WIDGETS_CREATE" { return "false",true }
  return "",false
 }
 cfg,err:=config.LoadFrom(lookup)
 if err!=nil { t.Fatal(err) }
 if cfg.Features["widgets-create"]==nil || *cfg.Features["widgets-create"] { t.Fatal("explicit false lost") }
 enabled:=true
 cfg.Features["widgets-create"]=&enabled
 cfg.Features["private-report"]=&enabled
 router:=app.New(cfg,transport.Authentication{Verifier:trustedAuth{permission:true},Idempotency:localIdempotency(t)},slog.New(slog.NewTextHandler(io.Discard,nil)),publishedPolicy(t))
 request:=httptest.NewRequest("GET","/api/features",nil)
 request.Header.Set("Authorization","Bearer trusted")
 request.Header.Set("Idempotency-Key","fixture-key")
 request.Header.Set("X-Tenant-ID","member-tenant")
 response:=httptest.NewRecorder()
 router.ServeHTTP(response,request)
 var envelope struct { Data map[string]bool `json:"data"` }
 if err:=json.Unmarshal(response.Body.Bytes(),&envelope);err!=nil { t.Fatal(err) }
 if response.Code!=200 || !envelope.Data["widgets-create"] || len(envelope.Data)!=1 || response.Header().Get("Cache-Control")!="no-store" { t.Fatalf("visible flags: %s",response.Body) }
 request=httptest.NewRequest(paths.WidgetsCreate.Method,"/api/widgets/item-1",strings.NewReader(`{"value":"input"}`))
 request.Header.Set("Authorization","Bearer trusted")
 request.Header.Set("Idempotency-Key","fixture-key")
 request.Header.Set("X-Tenant-ID","member-tenant")
 response=httptest.NewRecorder()
 router.ServeHTTP(response,request)
 if response.Code!=501 || !strings.Contains(response.Body.String(),"not_implemented") { t.Fatalf("stub claimed success: %d %s",response.Code,response.Body) }
}

func publishedPolicy(t testing.TB) *rbac.Policy {
 t.Helper()
 policy,err:=access.NewPolicy()
 if err!=nil { t.Fatal(err) }
 return policy
}

func TestUnknownRolesDoNotRetainGrants(t *testing.T) {
 for _,policy:=range []*rbac.Policy{publishedPolicy(t),nil} {
  router:=chi.NewRouter()
  operation:=&recordingOperation{}
  enabled:=true
  reg:=transport.Registrar{
   Router:router,
   Auth:trustedAuth{permission:true,unknownRole:policy!=nil},
   Features:features.New(map[string]*bool{"widgets-create":&enabled}),
   Logger:slog.New(slog.NewTextHandler(io.Discard,nil)),
   Policy:policy,
  }
  reg.Idempotency=localIdempotency(t)
 widgets.RegisterCreate(reg,operation,16*1024)
  request:=httptest.NewRequest("POST","/api/widgets/item-1",strings.NewReader(`{}`))
  request.Header.Set("Authorization","Bearer trusted")
 request.Header.Set("Idempotency-Key","fixture-key")
  request.Header.Set("X-Tenant-ID","member-tenant")
  response:=httptest.NewRecorder()
  router.ServeHTTP(response,request)
  if response.Code!=403 || operation.calls!=0 {
   t.Fatalf("unknown role/nil policy retained grants: status=%d calls=%d",response.Code,operation.calls)
  }
 }
}

func localIdempotency(t testing.TB) *httpidem.Handler {
 t.Helper()
 store,_:=memory.New(100)
 handler,err:=transport.NewIdempotency(store,16*1024)
 if err!=nil{t.Fatal(err)}
 return handler
}

func TestWriteReplayAndCurrentGates(t *testing.T) {
 idempotent:=localIdempotency(t)
 operation:=&recordingOperation{}
 send:=func(token,key,body string,permission,enabled bool)*httptest.ResponseRecorder{
  router:=chi.NewRouter()
  reg:=transport.Registrar{Router:router,Auth:trustedAuth{permission:permission},Features:features.New(map[string]*bool{"widgets-create":&enabled}),Policy:publishedPolicy(t),Logger:slog.New(slog.NewTextHandler(io.Discard,nil)),Idempotency:idempotent}
  widgets.RegisterCreate(reg,operation,16*1024)
  r:=httptest.NewRequest("POST","/api/widgets/item-1",strings.NewReader(body))
  r.Header.Set("Authorization","Bearer "+token)
  r.Header.Set("X-Tenant-ID","member-tenant")
  r.Header.Set("Idempotency-Key",key)
  r.Header.Set("Content-Type","application/json")
  w:=httptest.NewRecorder();router.ServeHTTP(w,r);return w
 }
 first:=send("trusted","retry",`{"value":"input"}`,true,true)
 replay:=send("trusted","retry",`{"value":"input"}`,true,true)
 if first.Code!=200||replay.Code!=200||first.Body.String()!=replay.Body.String()||operation.calls!=1{t.Fatal(first,replay,operation.calls)}
 for _,test:=range []struct{token,key,body string;permission,enabled bool;status int}{
  {"trusted","retry",`{"value":"changed"}`,true,true,409},
  {"trusted","",`{"value":"input"}`,true,true,400},
  {"bad","retry",`{"value":"input"}`,true,true,401},
  {"trusted","retry",`{"value":"input"}`,false,true,403},
  {"trusted","retry",`{"value":"input"}`,true,false,403},
 }{
  w:=send(test.token,test.key,test.body,test.permission,test.enabled)
  if w.Code!=test.status||operation.calls!=1{t.Fatal(w,operation.calls)}
 }
}

