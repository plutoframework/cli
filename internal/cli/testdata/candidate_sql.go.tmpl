type candidateSQLCache struct {
	cache.Store
	reads atomic.Int32
}

func (s *candidateSQLCache) Get(ctx context.Context, key string) ([]byte, bool, error) {
	s.reads.Add(1)
	return s.Store.Get(ctx, key)
}

type candidateSQLFixture struct {
	pool           *pgxpool.Pool
	manager        *auth.Manager
	machine        *state.Machine[domain.RecordStatus, domain.RecordEvent, bool]
	tokens         map[string]string
	gates          map[string]*identitygate.Gate
	data           map[string]*data.RecordData
	cache          *candidateSQLCache
	denyRole       atomic.Bool
	denyMembership atomic.Bool
	denyResource   atomic.Bool
	guard          string
	visibility     string
	table          string
}

func candidateSQLSetup(t *testing.T) *candidateSQLFixture {
	t.Helper()
	url := os.Getenv("PLUTO_CLI_TEST_DATABASE_URL")
	if url == "" {
		t.Fatal("required generated SQL fixture needs PLUTO_CLI_TEST_DATABASE_URL")
	}
	f := &candidateSQLFixture{
		tokens: map[string]string{}, gates: map[string]*identitygate.Gate{},
		data: map[string]*data.RecordData{}, guard: os.Getenv("PLUTO_CLI_TEST_GUARD_MODE"),
		visibility: os.Getenv("PLUTO_CLI_TEST_VISIBILITY"), table: os.Getenv("PLUTO_CLI_TEST_RESOURCE_TABLE"),
	}
	if f.guard == "" {
		f.guard = "not_owner"
	}
	if f.visibility == "" {
		f.visibility = "tenant"
	}
	if f.table == "" {
		f.table = "records"
	}
	if f.guard != "none" && f.guard != "owner" && f.guard != "not_owner" {
		t.Fatal("unsupported fixture guard")
	}
	if f.visibility != "owner" && f.visibility != "tenant" {
		t.Fatal("unsupported fixture visibility")
	}
	if f.table != "records" && f.table != "order" && f.table != "select" {
		t.Fatal("unsupported fixture table")
	}
	profiles := map[string]bool{"not_owner|tenant|records": true, "owner|tenant|select": true, "none|owner|order": true}
	if !profiles[f.guard+"|"+f.visibility+"|"+f.table] {
		t.Fatal("unsupported generated SQL fixture profile")
	}
	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Second)
	defer cancel()
	admin, err := pgxpool.New(ctx, url)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(admin.Close)
	schema := pgx.Identifier{"candidate_sql_" + jobs.NewID()}.Sanitize()
	if _, err := admin.Exec(ctx, "CREATE SCHEMA "+schema); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		cleanup, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if _, err := admin.Exec(cleanup, "DROP SCHEMA "+schema+" CASCADE"); err != nil {
			t.Error(err)
		}
	})
	config, err := pgxpool.ParseConfig(url)
	if err != nil {
		t.Fatal(err)
	}
	config.ConnConfig.RuntimeParams["search_path"] = strings.Trim(schema, `"`)
	f.pool, err = pgxpool.NewWithConfig(ctx, config)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(f.pool.Close)
	for _, name := range []string{"003_idempotency.sql", "005_jobs.sql", "100_documents_record.sql"} {
		migration, err := os.ReadFile(filepath.Join("..", "..", "db", "migrations", name))
		if err != nil {
			t.Fatal(err)
		}
		if _, err := f.pool.Exec(ctx, string(migration)); err != nil {
			t.Fatal(err)
		}
	}
	sessions, err := authmemory.New(32)
	if err != nil {
		t.Fatal(err)
	}
	f.manager, err = auth.New(sessions, auth.Config{TTL: time.Hour, Clock: time.Now})
	if err != nil {
		t.Fatal(err)
	}
	for _, actor := range []string{"alice", "bob"} {
		issued, err := f.manager.Start(ctx, actor)
		if err != nil {
			t.Fatal(err)
		}
		f.tokens[actor] = issued.Token
	}
	f.machine, err = domain.NewRecordMachine()
	if err != nil {
		t.Fatal(err)
	}
	memory, err := cachememory.New(cachememory.DefaultConfig())
	if err != nil {
		t.Fatal(err)
	}
	f.cache = &candidateSQLCache{Store: memory}
	operationIDs := []string{"documents.Create", "documents.Load", "documents.List", "documents.Export", "documents.Approve"}
	permissions := []rbac.Permission{}
	grants := []rbac.PermissionID{}
	for _, operation := range operationIDs {
		permission := rbac.PermissionID(strings.ToLower(operation))
		permissions = append(permissions, rbac.Permission{ID: permission, Name: operation, Description: "Generated SQL fixture operation"})
		grants = append(grants, permission)
	}
	policy, err := rbac.New(rbac.Definition{
		Permissions: permissions,
		Roles:       []rbac.Role{{ID: "operator", Name: "Operator", Description: "Scoped SQL fixture operator", Permissions: grants}},
	})
	if err != nil {
		t.Fatal(err)
	}
	authorizer, err := rbac.NewAuthorizer(policy, rbac.RoleResolverFunc(func(context.Context, string, rbac.Scope) ([]rbac.RoleID, error) {
		if f.denyRole.Load() {
			return nil, nil
		}
		return []rbac.RoleID{"operator"}, nil
	}), rbac.Options{RequireTenant: true})
	if err != nil {
		t.Fatal(err)
	}
	for _, operation := range operationIDs {
		permission, err := authorizer.Require(rbac.PermissionID(strings.ToLower(operation)))
		if err != nil {
			t.Fatal(err)
		}
		resource, err := data.NewRecordResourcePolicy(f.pool, operation)
		if err != nil {
			t.Fatal(err)
		}
		resourceGate, err := permission.WithResourcePolicy(rbac.ResourcePolicyFunc(func(ctx context.Context, request rbac.Request, id string) error {
			if f.denyResource.Load() {
				return rbac.ErrForbidden
			}
			return resource.AuthorizeResource(ctx, request, id)
		}))
		if err != nil {
			t.Fatal(err)
		}
		gate, err := identitygate.New(f.manager, resourceGate, identitygate.MembershipVerifierFunc(func(_ context.Context, subject, tenant string) error {
			if f.denyMembership.Load() || (subject != "alice" && subject != "bob") || (tenant != "north" && tenant != "south") {
				return rbac.ErrForbidden
			}
			return nil
		}))
		if err != nil {
			t.Fatal(err)
		}
		f.gates[operation] = gate
		f.data[operation], err = data.NewRecordData(f.pool, gate, f.machine, f.cache, "candidate-sql", "test", operation)
		if err != nil {
			t.Fatal(err)
		}
	}
	return f
}

func (f *candidateSQLFixture) run(t *testing.T, operation, actor, tenant, resource string, run func(context.Context, *identitygate.Execution, *data.RecordData) error) error {
	t.Helper()
	return f.manager.WithIdentity(t.Context(), f.tokens[actor], func(ctx context.Context, identity *auth.Identity) error {
		return f.gates[operation].Within(ctx, identity, tenant, resource, func(ctx context.Context, execution *identitygate.Execution) error {
			return run(ctx, execution, f.data[operation])
		})
	})
}

func candidateSQLCommand(t *testing.T, kind, id, key, value string, limit int, cursor string) domain.RecordCommand {
	t.Helper()
	command, err := domain.NewRecordCommand(kind, id, key, value, limit, cursor)
	if err != nil {
		t.Fatal(err)
	}
	return command
}

func (f *candidateSQLFixture) create(t *testing.T, actor, tenant, id, key, value string) contract.RecordResult {
	t.Helper()
	command := candidateSQLCommand(t, "create", id, key, value, 0, "")
	var result contract.RecordResult
	err := f.run(t, "documents.Create", actor, tenant, command.ID(), func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		var err error
		result, err = repository.Create(ctx, execution, command)
		return err
	})
	if err != nil {
		t.Fatal(err)
	}
	return result
}

func (f *candidateSQLFixture) allowedActor() string {
	if f.guard == "not_owner" {
		return "bob"
	}
	return "alice"
}

func (f *candidateSQLFixture) assertState(t *testing.T, id, status string, version int64, approvals, queued, completed, pending int) {
	t.Helper()
	var gotState string
	var gotVersion int64
	if err := f.pool.QueryRow(t.Context(), "SELECT state,version FROM "+pgx.Identifier{f.table}.Sanitize()+" WHERE tenant_id='north' AND id=$1", id).Scan(&gotState, &gotVersion); err != nil {
		t.Fatal(err)
	}
	var audit, jobs, done, waiting int
	if err := f.pool.QueryRow(t.Context(), `SELECT count(*) FROM "pluto_resource_audit" WHERE "operation"='documents.Approve'`).Scan(&audit); err != nil {
		t.Fatal(err)
	}
	if err := f.pool.QueryRow(t.Context(), `SELECT count(*) FROM "pluto_jobs"`).Scan(&jobs); err != nil {
		t.Fatal(err)
	}
	if err := f.pool.QueryRow(t.Context(), `SELECT count(*) FILTER(WHERE completed),count(*) FILTER(WHERE NOT completed) FROM "pluto_idempotency"`).Scan(&done, &waiting); err != nil {
		t.Fatal(err)
	}
	if gotState != status || gotVersion != version || audit != approvals || jobs != queued || done != completed || waiting != pending {
		t.Fatalf("SQL_ATOMICITY state=%s version=%d audit=%d jobs=%d completed=%d pending=%d", gotState, gotVersion, audit, jobs, done, waiting)
	}
}

func TestCandidateSQLCreateNormalizeReplay(t *testing.T) {
	f := candidateSQLSetup(t)
	first := f.create(t, "alice", "north", "doc-1", "create-1", "  canonical value  ")
	if first.ID != "doc-1" || first.Value != "canonical value" || string(first.State) != "draft" || first.Version != 1 {
		t.Fatalf("NORMALIZATION result=%+v", first)
	}
	replay := f.create(t, "alice", "north", "doc-1", "create-1", "  canonical value  ")
	if !reflect.DeepEqual(first, replay) {
		t.Fatal("CREATE_REPLAY changed result")
	}
	f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 0)
	other := candidateSQLCommand(t, "create", "doc-other", "create-1", "canonical value", 0, "")
	err := f.run(t, "documents.Create", "alice", "north", other.ID(), func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		_, err := repository.Create(ctx, execution, other)
		return err
	})
	if !errors.Is(err, idempotency.ErrConflict) {
		t.Fatalf("CREATE_FINGERPRINT %v", err)
	}
	south := f.create(t, "alice", "south", "doc-1", "create-1", "southern value")
	if south.Value != "southern value" {
		t.Fatal("TENANT_CREATE collision")
	}
	for _, tenant := range []string{"north", "south"} {
		err := f.run(t, "documents.Load", "alice", tenant, "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
			record, err := repository.Load(ctx, execution, "doc-1")
			if err != nil {
				return err
			}
			expected := "canonical value"
			if tenant == "south" {
				expected = "southern value"
			}
			if record.Value() != expected || record.TenantID() != tenant {
				return errors.New("TENANT_CACHE_COLLISION")
			}
			return nil
		})
		if err != nil {
			t.Fatal(err)
		}
	}
	if _, err := domain.NewRecordCommand("create", "doc", " key ", "value", 0, ""); err == nil {
		t.Fatal("KEY_NORMALIZATION silently changed logical key")
	}
	if _, err := domain.NewRecordCommand("create", "doc", "key", strings.Repeat("x", 8193), 0, ""); err == nil {
		t.Fatal("VALUE_BOUND accepted")
	}
	if _, err := domain.NewRecordCommand("create", "doc", "key", string([]byte{0xff}), 0, ""); err == nil {
		t.Fatal("INVALID_UTF8 canonicalization accepted")
	}

}

func TestCandidateSQLAuthoritativeGuardAndCache(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "north", "doc-1", "create-1", "value")
	actor := "alice"
	if f.guard == "owner" {
		actor = "bob"
	}
	poison := map[string]any{"ID": "doc-1", "TenantID": "north", "OwnerID": "bob", "State": "draft", "Version": 1, "Value": "value"}
	if f.guard == "none" {
		poison["OwnerID"] = "alice"
		poison["Version"] = 99
	}
	encoded, err := json.Marshal(poison)
	if err != nil {
		t.Fatal(err)
	}
	key, err := cache.Key(cache.Scope{App: "candidate-sql", Environment: "test", Namespace: "document-records", Version: "1", TenantID: "north", SubjectID: actor}, "doc-1")
	if err != nil {
		t.Fatal(err)
	}
	if err := f.cache.Set(t.Context(), key, encoded, time.Minute); err != nil {
		t.Fatal(err)
	}
	err = f.run(t, "documents.Load", actor, "north", "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		record, err := repository.Load(ctx, execution, "doc-1")
		if err != nil {
			return err
		}
		if f.guard == "none" && record.Version() != 99 {
			return errors.New("CACHE_POISON_CONTROL")
		}
		if f.guard != "none" && record.OwnerID() != "bob" {
			return errors.New("CACHE_POISON_CONTROL")
		}
		before := f.cache.reads.Load()
		f.denyRole.Store(true)
		if _, err := repository.Load(ctx, execution, "doc-1"); !errors.Is(err, rbac.ErrForbidden) {
			return fmt.Errorf("CACHE_PERMISSION %v", err)
		}
		f.denyRole.Store(false)
		f.denyMembership.Store(true)
		if _, err := repository.Load(ctx, execution, "doc-1"); !errors.Is(err, rbac.ErrForbidden) {
			return fmt.Errorf("CACHE_MEMBERSHIP %v", err)
		}
		f.denyMembership.Store(false)
		f.denyResource.Store(true)
		if _, err := repository.Load(ctx, execution, "doc-1"); !errors.Is(err, rbac.ErrForbidden) {
			return fmt.Errorf("CACHE_RESOURCE %v", err)
		}
		f.denyResource.Store(false)
		if f.cache.reads.Load() != before {
			return errors.New("DENIED_AUTHORITY_TOUCHED_CACHE")
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	command := candidateSQLCommand(t, "transition", "doc-1", "guard-1", "", 0, "")
	reached := false
	err = f.run(t, "documents.Approve", actor, "north", "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		reached = true
		attempt, err := repository.Start(ctx, execution, command)
		if err != nil {
			return err
		}
		record, err := repository.Load(ctx, execution, "doc-1")
		if err != nil {
			return err
		}
		change, err := domain.EvaluateRecord(f.machine, record, "submit", execution.SubjectID())
		if f.guard != "none" {
			if !errors.Is(err, state.ErrGuard) {
				return errors.New("CACHE_GUARD_AUTHORITY")
			}
			return nil
		}
		if err != nil {
			return fmt.Errorf("AUTHORITATIVE_NONE_GUARD %w", err)
		}
		_, err = repository.Commit(ctx, execution, attempt, change)
		return err
	})
	if f.guard != "none" {
		if !errors.Is(err, state.ErrGuard) || reached {
			t.Fatalf("AUTHORITATIVE_ACTOR_POLICY err=%v callback=%v", err, reached)
		}
		f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 0)
	} else {
		if err != nil {
			t.Fatal(err)
		}
		f.assertState(t, "doc-1", "approved", 2, 1, 1, 2, 0)
	}
}

type candidateSQLForgedAttempt struct{}

func (candidateSQLForgedAttempt) Replayed() (contract.RecordResult, bool) {
	return contract.RecordResult{}, false
}

func TestCandidateSQLAtomicTransitionAndReplay(t *testing.T) {
	for _, failure := range []string{"none", "audit", "outbox", "completion", "commit"} {
		t.Run(failure, func(t *testing.T) {
			f := candidateSQLSetup(t)
			escaped := strings.Repeat(`"`, 8192)
			f.create(t, "alice", "north", "doc-1", "create-1", escaped)
			command := candidateSQLCommand(t, "transition", "doc-1", "approve-1", "", 0, "")
			var first contract.RecordResult
			err := f.run(t, "documents.Approve", f.allowedActor(), "north", "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
				attempt, err := repository.Start(ctx, execution, command)
				if err != nil {
					return err
				}
				record, err := repository.Load(ctx, execution, "doc-1")
				if err != nil {
					return err
				}
				change, err := domain.EvaluateRecord(f.machine, record, "submit", execution.SubjectID())
				if err != nil {
					return err
				}
				if _, err := repository.Commit(ctx, execution, candidateSQLForgedAttempt{}, change); err == nil {
					return errors.New("FORGED_ATTEMPT")
				}
				if _, err := repository.Commit(ctx, execution, attempt, state.Evaluated[domain.RecordStatus, domain.RecordEvent]{}); !errors.Is(err, state.ErrEvaluated) {
					return fmt.Errorf("ZERO_TOKEN %v", err)
				}
				foreign, err := domain.NewRecordMachine()
				if err != nil {
					return err
				}
				foreignChange, err := domain.EvaluateRecord(foreign, record, "submit", execution.SubjectID())
				if err != nil {
					return err
				}
				if _, err := repository.Commit(ctx, execution, attempt, foreignChange); !errors.Is(err, state.ErrMachine) {
					return fmt.Errorf("FOREIGN_MACHINE %v", err)
				}
				wrongVersion, err := domain.RehydrateRecord(record.ID(), record.TenantID(), record.OwnerID(), string(record.State()), record.Version()+1, record.Value())
				if err != nil {
					return err
				}
				versionChange, err := domain.EvaluateRecord(f.machine, wrongVersion, "submit", execution.SubjectID())
				if err != nil {
					return err
				}
				if _, err := repository.Commit(ctx, execution, attempt, versionChange); !errors.Is(err, data.ErrRecordConflict) {
					return fmt.Errorf("EXPECTED_VERSION_PREDICATE %v", err)
				}

				switch failure {
				case "audit":
					_, err = f.pool.Exec(ctx, `ALTER TABLE "pluto_resource_audit" ADD CONSTRAINT injected_failure CHECK ("operation"<>'documents.Approve') NOT VALID`)
				case "outbox":
					_, err = f.pool.Exec(ctx, `ALTER TABLE "pluto_jobs" ADD CONSTRAINT injected_failure CHECK(false) NOT VALID`)
				case "completion":
					_, err = f.pool.Exec(ctx, `ALTER TABLE "pluto_idempotency" ADD CONSTRAINT injected_failure CHECK(NOT completed) NOT VALID`)
				case "commit":
					_, err = f.pool.Exec(ctx, `CREATE FUNCTION injected_failure() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN RAISE EXCEPTION 'injected commit failure'; END$$; CREATE CONSTRAINT TRIGGER injected_failure AFTER UPDATE ON `+pgx.Identifier{f.table}.Sanitize()+` DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION injected_failure()`)
				}
				if err != nil {
					return err
				}
				first, err = repository.Commit(ctx, execution, attempt, change)
				if failure != "none" {
					if err == nil {
						return errors.New("ATOMIC_FAILURE_ACCEPTED")
					}
					var sqlError *pgconn.PgError
					if !errors.As(err, &sqlError) {
						return fmt.Errorf("UNRELATED_ATOMIC_FAILURE %w", err)
					}
					if failure == "commit" {
						if sqlError.Code != "P0001" || sqlError.Message != "injected commit failure" {
							return fmt.Errorf("WRONG_COMMIT_FAILURE %w", err)
						}
					} else {
						expectedTable := map[string]string{"audit": "pluto_resource_audit", "outbox": "pluto_jobs", "completion": "pluto_idempotency"}[failure]
						if sqlError.Code != "23514" || sqlError.ConstraintName != "injected_failure" || sqlError.TableName != expectedTable {
							return fmt.Errorf("WRONG_PARTICIPANT_FAILURE %w", err)
						}
					}

					f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 1)
					if _, err := repository.Start(ctx, execution, command); !errors.Is(err, idempotency.ErrInProgress) {
						return fmt.Errorf("PENDING_CLAIM_RESTARTED %v", err)
					}
					return nil
				}
				if err != nil {
					return err
				}
				if first.ID != "doc-1" || string(first.State) != "approved" || first.Version != 2 || first.Value != escaped || len(first.JobIDs) != 1 {
					return errors.New("ATOMIC_RESULT")
				}
				replay, err := repository.Start(ctx, execution, command)
				if err != nil {
					return err
				}
				result, replayed := replay.Replayed()
				if !replayed || !reflect.DeepEqual(result, first) {
					return errors.New("TRANSITION_REPLAY")
				}
				if _, err := repository.Commit(ctx, execution, attempt, change); !errors.Is(err, data.ErrRecordConflict) {
					return fmt.Errorf("STALE_CAS %v", err)
				}
				return nil
			})
			if err != nil {
				t.Fatal(err)
			}
			if failure == "none" {
				f.assertState(t, "doc-1", "approved", 2, 1, 1, 2, 0)
				var payload []byte
				var attempts int
				if err := f.pool.QueryRow(t.Context(), `SELECT payload,max_attempts FROM "pluto_jobs" WHERE id=$1`, first.JobIDs[0]).Scan(&payload, &attempts); err != nil {
					t.Fatal(err)
				}
				var notice contract.RecordEffectPayload
				if err := json.Unmarshal(payload, &notice); err != nil {
					t.Fatal(err)
				}
				if notice.ResourceID != "doc-1" || notice.IdempotencyKey != first.JobIDs[0] || notice.Value != escaped || attempts != 3 || len(payload) > jobs.MaxPayloadBytes {
					t.Fatal("TYPED_EFFECT_BOUNDS_OR_STABLE_ID")
				}
				var actor string
				if err := f.pool.QueryRow(t.Context(), `SELECT actor_id FROM "pluto_resource_audit" WHERE operation='documents.Approve'`).Scan(&actor); err != nil {
					t.Fatal(err)
				}
				if actor != f.allowedActor() {
					t.Fatal("AUDIT_ACTOR")
				}
			}
		})
	}
}

func TestCandidateSQLVisiblePagesAndExport(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "south", "00-foreign", "foreign-1", "hidden")
	if f.visibility == "owner" {
		f.create(t, "bob", "north", "00-other-owner", "other-owner", "hidden")
	}
	for index := 1; index <= 3; index++ {
		id := fmt.Sprintf("doc-%d", index)
		f.create(t, "alice", "north", id, id, "value")
	}
	var cursor string
	err := f.run(t, "documents.List", "alice", "north", "documents.Record", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		page, err := repository.List(ctx, execution, candidateSQLCommand(t, "list", "", "", "", 2, ""))
		if err != nil {
			return err
		}
		if len(page.Data) != 2 || page.Data[0].ID != "doc-1" || page.Data[1].ID != "doc-2" || !page.Page.HasMore {
			return errors.New("VISIBILITY_BEFORE_LIMIT")
		}
		cursor = page.Page.NextCursor
		next, err := repository.List(ctx, execution, candidateSQLCommand(t, "list", "", "", "", 2, cursor))
		if err != nil {
			return err
		}
		if len(next.Data) != 1 || next.Data[0].ID != "doc-3" || next.Page.HasMore {
			return errors.New("VISIBLE_CONTINUATION")
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	err = f.run(t, "documents.List", "bob", "north", "documents.Record", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		_, err := repository.List(ctx, execution, candidateSQLCommand(t, "list", "", "", "", 2, cursor))
		if !errors.Is(err, pagination.ErrInvalid) {
			return fmt.Errorf("ACTOR_CURSOR_REPLAY %v", err)
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	err = f.run(t, "documents.List", "alice", "south", "documents.Record", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		_, err := repository.List(ctx, execution, candidateSQLCommand(t, "list", "", "", "", 2, cursor))
		if !errors.Is(err, pagination.ErrInvalid) {
			return fmt.Errorf("TENANT_CURSOR_REPLAY %v", err)
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	err = f.run(t, "documents.Export", "alice", "north", "documents.Record", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		rows, err := repository.Export(ctx, execution, candidateSQLCommand(t, "export", "", "", "", 4, ""))
		if err != nil {
			return err
		}
		if len(rows) != 3 {
			return errors.New("VISIBLE_EXPORT")
		}
		rows, err = repository.Export(ctx, execution, candidateSQLCommand(t, "export", "", "", "", 2, ""))
		if !errors.Is(err, data.ErrRecordExport) || rows != nil {
			return fmt.Errorf("EXPORT_BOUND %v", err)
		}
		f.denyMembership.Store(true)
		rows, err = repository.Export(ctx, execution, candidateSQLCommand(t, "export", "", "", "", 4, ""))
		f.denyMembership.Store(false)
		if !errors.Is(err, rbac.ErrForbidden) || rows != nil {
			return fmt.Errorf("EXPORT_REAUTH %v", err)
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
}

func TestCandidateSQLConcurrentLogicalCommand(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "north", "doc-1", "create-1", "value")
	command := candidateSQLCommand(t, "transition", "doc-1", "concurrent", "", 0, "")
	type outcome struct {
		result contract.RecordResult
		err    error
	}
	outcomes := make(chan outcome, 12)
	var wg sync.WaitGroup
	for range 12 {
		wg.Go(func() {
			var result contract.RecordResult
			err := f.run(t, "documents.Approve", f.allowedActor(), "north", "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
				attempt, err := repository.Start(ctx, execution, command)
				if err != nil {
					return err
				}
				if replay, yes := attempt.Replayed(); yes {
					result = replay
					return nil
				}
				record, err := repository.Load(ctx, execution, "doc-1")
				if err != nil {
					return err
				}
				change, err := domain.EvaluateRecord(f.machine, record, "submit", execution.SubjectID())
				if err != nil {
					return err
				}
				result, err = repository.Commit(ctx, execution, attempt, change)
				return err
			})
			outcomes <- outcome{result: result, err: err}
		})
	}
	wg.Wait()
	close(outcomes)
	accepted := 0
	delivery := ""
	for outcome := range outcomes {
		if outcome.err != nil {
			if !errors.Is(outcome.err, idempotency.ErrInProgress) {
				t.Fatal(outcome.err)
			}
			continue
		}
		accepted++
		if len(outcome.result.JobIDs) != 1 {
			t.Fatal("CONCURRENT_EFFECT_MISSING")
		}
		if delivery != "" && delivery != outcome.result.JobIDs[0] {
			t.Fatal("CONCURRENT_DELIVERY_ID_CHANGED")
		}
		delivery = outcome.result.JobIDs[0]
	}
	if accepted == 0 {
		t.Fatal("NO_LOGICAL_COMMAND_COMMITTED")
	}
	f.assertState(t, "doc-1", "approved", 2, 1, 1, 2, 0)
}

func TestCandidateSQLForgedActorFactDenied(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "north", "doc-1", "create-1", "value")
	actor := f.allowedActor()
	command := candidateSQLCommand(t, "transition", "doc-1", "forged-facts", "", 0, "")
	err := f.run(t, "documents.Approve", actor, "north", "doc-1", func(ctx context.Context, execution *identitygate.Execution, repository *data.RecordData) error {
		attempt, err := repository.Start(ctx, execution, command)
		if err != nil {
			return err
		}
		// Hold the version fixed deliberately: this isolates the current policy
		// backstop from the separate stale-version backstop. Managed writes do not
		// expose this arbitrary owner mutation.
		tag, err := f.pool.Exec(ctx, "UPDATE "+pgx.Identifier{f.table}.Sanitize()+" SET owner_id='bob' WHERE tenant_id='north' AND id='doc-1'")
		if err != nil {
			return err
		}
		if tag.RowsAffected() != 1 {
			return errors.New("FORGED_FACTS_SETUP_ROW_MISSING")
		}
		var id, tenant, owner, status, value string
		var version int64
		if err := f.pool.QueryRow(ctx, "SELECT id,tenant_id,owner_id,state,version,value FROM "+pgx.Identifier{f.table}.Sanitize()+" WHERE tenant_id='north' AND id='doc-1'").Scan(&id, &tenant, &owner, &status, &version, &value); err != nil {
			return err
		}
		if owner != "bob" || version != 1 || status != "draft" {
			return errors.New("FORGED_FACTS_SETUP_NOT_APPLIED")
		}
		actual, err := domain.RehydrateRecord(id, tenant, owner, status, version, value)
		if err != nil {
			return err
		}
		forgedActor := "bob"
		if f.guard == "not_owner" {
			forgedActor = "alice"
		}
		forged, err := domain.EvaluateRecord(f.machine, actual, "submit", forgedActor)
		if err != nil {
			return fmt.Errorf("forged-token positive control: %w", err)
		}
		_, err = repository.Commit(ctx, execution, attempt, forged)
		if f.guard == "none" {
			if !errors.Is(err, rbac.ErrForbidden) {
				return fmt.Errorf("AUTHORITATIVE_OWNER_SCOPE %v", err)
			}
		} else if !errors.Is(err, state.ErrGuard) {
			return fmt.Errorf("FORGED_ACTOR_FACTS_COMMITTED %v", err)
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 1)
}
