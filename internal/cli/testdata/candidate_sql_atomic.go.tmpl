type candidateSQLForgedAttempt struct{}

func (candidateSQLForgedAttempt) Replayed() (contract.RecordResult, bool) {
	return contract.RecordResult{}, false
}

func TestCandidateSQLAtomicTransitionAndReplay(t *testing.T) {
	for _, failure := range []string{
		"none",
		"audit",
		"outbox",
		"completion",
		"commit",
	} {
		t.Run(failure, func(t *testing.T) {
			f := candidateSQLSetup(t)
			escaped := strings.Repeat(`"`, 8192)
			f.create(t, "alice", "north", "doc-1", "create-1", escaped)

			command := candidateSQLCommand(
				t,
				"transition",
				"doc-1",
				"approve-1",
				"",
				0,
				"",
			)

			var first contract.RecordResult

			err := f.run(
				t,
				"documents.Approve",
				f.allowedActor(),
				"north",
				"doc-1",
				func(
					ctx context.Context,
					execution *identitygate.Execution,
					repository *data.RecordData,
				) error {
					attempt, err := repository.Start(ctx, execution, command)
					if err != nil {
						return err
					}

					record, err := repository.Load(ctx, execution, "doc-1")
					if err != nil {
						return err
					}

					change, err := domain.EvaluateRecord(
						f.machine,
						record,
						"submit",
						execution.SubjectID(),
					)
					if err != nil {
						return err
					}

					if _, err := repository.Commit(
						ctx,
						execution,
						candidateSQLForgedAttempt{},
						change,
					); err == nil {
						return errors.New("FORGED_ATTEMPT")
					}

					if _, err := repository.Commit(
						ctx,
						execution,
						attempt,
						state.Evaluated[
							domain.RecordStatus,
							domain.RecordEvent,
						]{},
					); !errors.Is(
						err,
						state.ErrEvaluated,
					) {
						return fmt.Errorf("ZERO_TOKEN %v", err)
					}

					foreign, err := domain.NewRecordMachine()
					if err != nil {
						return err
					}

					foreignChange, err := domain.EvaluateRecord(
						foreign,
						record,
						"submit",
						execution.SubjectID(),
					)
					if err != nil {
						return err
					}

					if _, err := repository.Commit(
						ctx,
						execution,
						attempt,
						foreignChange,
					); !errors.Is(
						err,
						state.ErrMachine,
					) {
						return fmt.Errorf("FOREIGN_MACHINE %v", err)
					}

					wrongVersion, err := domain.RehydrateRecord(
						record.ID(),
						record.TenantID(),
						record.OwnerID(),
						string(record.State()),
						record.Version()+1,
						record.Value(),
					)
					if err != nil {
						return err
					}

					versionChange, err := domain.EvaluateRecord(
						f.machine,
						wrongVersion,
						"submit",
						execution.SubjectID(),
					)
					if err != nil {
						return err
					}

					if _, err := repository.Commit(
						ctx,
						execution,
						attempt,
						versionChange,
					); !errors.Is(
						err,
						data.ErrRecordConflict,
					) {
						return fmt.Errorf("EXPECTED_VERSION_PREDICATE %v", err)
					}

					switch failure {
					case "audit":
						_, err = f.pool.Exec(
							ctx,
							"ALTER TABLE \"pluto_resource_audit\" ADD "+
								"CONSTRAINT injected_failure CHECK "+
								"(\"operation\"<>'documents.Approve') NOT "+
								"VALID",
						)
					case "outbox":
						_, err = f.pool.Exec(
							ctx,
							"ALTER TABLE \"pluto_jobs\" ADD CONSTRAINT "+
								"injected_failure CHECK(false) NOT VALID",
						)
					case "completion":
						_, err = f.pool.Exec(
							ctx,
							"ALTER TABLE \"pluto_idempotency\" ADD "+
								"CONSTRAINT injected_failure CHECK(NOT "+
								"completed) NOT VALID",
						)
					case "commit":
						_, err = f.pool.Exec(
							ctx,
							"CREATE FUNCTION injected_failure() RETURNS "+
								"trigger LANGUAGE plpgsql AS $$BEGIN RAISE "+
								"EXCEPTION 'injected commit failure'; END$$; "+
								"CREATE CONSTRAINT TRIGGER injected_failure "+
								"AFTER UPDATE ON "+pgx.Identifier{
								f.table,
							}.Sanitize()+" DEFERRABLE INITIALLY DEFERRED "+
								"FOR EACH ROW EXECUTE FUNCTION injected_"+
								"failure()",
						)
					}

					if err != nil {
						return err
					}

					first, err = repository.Commit(
						ctx,
						execution,
						attempt,
						change,
					)
					if failure != "none" {
						if err == nil {
							return errors.New("ATOMIC_FAILURE_ACCEPTED")
						}

						var sqlError *pgconn.PgError
						if !errors.As(err, &sqlError) {
							return fmt.Errorf(
								"UNRELATED_ATOMIC_FAILURE %w",
								err,
							)
						}

						if failure == "commit" {
							if sqlError.Code != "P0001" ||
								sqlError.Message != "injected commit failure" {
								return fmt.Errorf(
									"WRONG_COMMIT_FAILURE %w",
									err,
								)
							}
						} else {
							expectedTable := map[string]string{
								"audit":      "pluto_resource_audit",
								"outbox":     "pluto_jobs",
								"completion": "pluto_idempotency",
							}[failure]
							if sqlError.Code != "23514" ||
								sqlError.ConstraintName != "injected_failure" ||
								sqlError.TableName != expectedTable {
								return fmt.Errorf(
									"WRONG_PARTICIPANT_FAILURE %w",
									err,
								)
							}
						}

						f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 1)

						if _, err := repository.Start(
							ctx,
							execution,
							command,
						); !errors.Is(
							err,
							idempotency.ErrInProgress,
						) {
							return fmt.Errorf("PENDING_CLAIM_RESTARTED %v", err)
						}

						return nil
					}

					if err != nil {
						return err
					}

					if first.ID != "doc-1" ||
						string(first.State) != "approved" ||
						first.Version != 2 ||
						first.Value != escaped ||
						len(first.JobIDs) != 1 {
						return errors.New("ATOMIC_RESULT")
					}

					replay, err := repository.Start(ctx, execution, command)
					if err != nil {
						return err
					}

					result, replayed := replay.Replayed()
					if !replayed || !reflect.DeepEqual(result, first) {
						return errors.New("TRANSITION_REPLAY")
					}

					if _, err := repository.Commit(
						ctx,
						execution,
						attempt,
						change,
					); !errors.Is(
						err,
						data.ErrRecordConflict,
					) {
						return fmt.Errorf("STALE_CAS %v", err)
					}

					return nil
				},
			)
			if err != nil {
				t.Fatal(err)
			}

			if failure == "none" {
				f.assertState(t, "doc-1", "approved", 2, 1, 1, 2, 0)

				var (
					payload  []byte
					attempts int
				)
				if err := f.pool.QueryRow(
					t.Context(),
					"SELECT payload,max_"+
						"attempts FROM \"pluto_jobs\" WHERE id=$1",
					first.JobIDs[0],
				).
					Scan(&payload, &attempts); err != nil {
					t.Fatal(err)
				}

				var notice contract.RecordEffectPayload
				if err := json.Unmarshal(payload, &notice); err != nil {
					t.Fatal(err)
				}

				if notice.ResourceID != "doc-1" ||
					notice.IdempotencyKey != first.JobIDs[0] ||
					notice.Value != escaped ||
					attempts != 3 ||
					len(payload) > jobs.MaxPayloadBytes {
					t.Fatal("TYPED_EFFECT_BOUNDS_OR_STABLE_ID")
				}

				var actor string
				if err := f.pool.QueryRow(t.Context(), "SELECT actor_id "+
					"FROM \"pluto_resource_audit\" WHERE "+
					"operation='documents.Approve'").
					Scan(&actor); err != nil {
					t.Fatal(err)
				}

				if actor != f.allowedActor() {
					t.Fatal("AUDIT_ACTOR")
				}
			}
		})
	}
}

func TestCandidateSQLConcurrentLogicalCommand(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "north", "doc-1", "create-1", "value")

	command := candidateSQLCommand(
		t,
		"transition",
		"doc-1",
		"concurrent",
		"",
		0,
		"",
	)

	type outcome struct {
		result contract.RecordResult
		err    error
	}

	outcomes := make(chan outcome, 12)

	var wg sync.WaitGroup
	for range 12 {
		wg.Go(func() {
			var result contract.RecordResult

			err := f.run(
				t,
				"documents.Approve",
				f.allowedActor(),
				"north",
				"doc-1",
				func(
					ctx context.Context,
					execution *identitygate.Execution,
					repository *data.RecordData,
				) error {
					attempt, err := repository.Start(ctx, execution, command)
					if err != nil {
						return err
					}

					if replay, yes := attempt.Replayed(); yes {
						result = replay
						return nil
					}

					record, err := repository.Load(ctx, execution, "doc-1")
					if err != nil {
						return err
					}

					change, err := domain.EvaluateRecord(
						f.machine,
						record,
						"submit",
						execution.SubjectID(),
					)
					if err != nil {
						return err
					}

					result, err = repository.Commit(
						ctx,
						execution,
						attempt,
						change,
					)

					return err
				},
			)
			outcomes <- outcome{result: result, err: err}
		})
	}

	wg.Wait()
	close(outcomes)

	accepted := 0
	delivery := ""

	for outcome := range outcomes {
		if outcome.err != nil {
			if !errors.Is(outcome.err, idempotency.ErrInProgress) {
				t.Fatal(outcome.err)
			}

			continue
		}

		accepted++

		if len(outcome.result.JobIDs) != 1 {
			t.Fatal("CONCURRENT_EFFECT_MISSING")
		}

		if delivery != "" && delivery != outcome.result.JobIDs[0] {
			t.Fatal("CONCURRENT_DELIVERY_ID_CHANGED")
		}

		delivery = outcome.result.JobIDs[0]
	}

	if accepted == 0 {
		t.Fatal("NO_LOGICAL_COMMAND_COMMITTED")
	}

	f.assertState(t, "doc-1", "approved", 2, 1, 1, 2, 0)
}

func TestCandidateSQLForgedActorFactDenied(t *testing.T) {
	f := candidateSQLSetup(t)
	f.create(t, "alice", "north", "doc-1", "create-1", "value")

	actor := f.allowedActor()
	command := candidateSQLCommand(
		t,
		"transition",
		"doc-1",
		"forged-facts",
		"",
		0,
		"",
	)

	err := f.run(
		t,
		"documents.Approve",
		actor,
		"north",
		"doc-1",
		func(
			ctx context.Context,
			execution *identitygate.Execution,
			repository *data.RecordData,
		) error {
			attempt, err := repository.Start(ctx, execution, command)
			if err != nil {
				return err
			}

			// Hold the version fixed deliberately: this isolates the current
			// policy
			// backstop from the separate stale-version backstop. Managed writes
			// do not
			// expose this arbitrary owner mutation.
			tag, err := f.pool.Exec(
				ctx,
				"UPDATE "+pgx.Identifier{
					f.table,
				}.Sanitize()+" SET owner_id='bob' WHERE tenant_id='north' "+
					"AND id='doc-1'",
			)
			if err != nil {
				return err
			}

			if tag.RowsAffected() != 1 {
				return errors.New("FORGED_FACTS_SETUP_ROW_MISSING")
			}

			var (
				id, tenant, owner, status, value string
				version                          int64
			)
			if err := f.pool.QueryRow(
				ctx,
				"SELECT id,tenant_id,owner_id,state,version,value FROM "+
					pgx.Identifier{f.table}.Sanitize()+
					" WHERE tenant_id='north' AND id='doc-1'",
			).Scan(
				&id,
				&tenant,
				&owner,
				&status,
				&version,
				&value,
			); err != nil {
				return err
			}

			if owner != "bob" || version != 1 || status != "draft" {
				return errors.New("FORGED_FACTS_SETUP_NOT_APPLIED")
			}

			actual, err := domain.RehydrateRecord(
				id,
				tenant,
				owner,
				status,
				version,
				value,
			)
			if err != nil {
				return err
			}

			forgedActor := "bob"
			if f.guard == "not_owner" {
				forgedActor = "alice"
			}

			forged, err := domain.EvaluateRecord(
				f.machine,
				actual,
				"submit",
				forgedActor,
			)
			if err != nil {
				return fmt.Errorf("forged-token positive control: %w", err)
			}

			_, err = repository.Commit(ctx, execution, attempt, forged)
			if f.guard == "none" {
				if !errors.Is(err, rbac.ErrForbidden) {
					return fmt.Errorf("AUTHORITATIVE_OWNER_SCOPE %v", err)
				}
			} else if !errors.Is(err, state.ErrGuard) {
				return fmt.Errorf("FORGED_ACTOR_FACTS_COMMITTED %v", err)
			}

			return nil
		},
	)
	if err != nil {
		t.Fatal(err)
	}

	f.assertState(t, "doc-1", "draft", 1, 0, 0, 1, 1)
}
