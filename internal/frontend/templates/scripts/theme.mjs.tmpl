import { lstatSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { parse } from "smol-toml";

export const webRoot = fileURLToPath(new URL("../", import.meta.url));
export const manifestPath = path.resolve(webRoot, "../pluto.toml");
const banner = "/* Generated by Pluto from pluto.toml. Do not edit. */\n";
const tokens = new Set([
  "accent",
  "accent_foreground",
  "background",
  "foreground",
  "surface",
  "surface_foreground",
  "muted",
  "border",
  "success",
  "warning",
  "danger",
]);

function object(value, name) {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value) ||
    (Object.getPrototypeOf(value) !== Object.prototype &&
      Object.getPrototypeOf(value) !== null)
  )
    throw new Error(`${name} must be a table`);
  return value;
}

export function validateTheme(frontend) {
  object(frontend, "frontend");
  if (!["native", "heroui-v3", "shadcn"].includes(frontend.ui))
    throw new Error("Unknown frontend UI profile");
  const theme =
    frontend.theme === undefined
      ? {}
      : object(frontend.theme, "frontend.theme");
  for (const key of Object.keys(theme)) {
    if (
      !["mode", "radius", "font_family", "overrides", "light", "dark"].includes(
        key,
      )
    )
      throw new Error(`Unknown frontend.theme setting: ${key}`);
  }
  if (![undefined, "", "system", "light", "dark"].includes(theme.mode))
    throw new Error("frontend.theme.mode must be system, light or dark");
  if (
    theme.radius !== undefined &&
    theme.radius !== "" &&
    (typeof theme.radius !== "string" ||
      !/^(0|[0-9]{1,2}(\.[0-9]{1,3})?(px|rem))$/.test(theme.radius))
  )
    throw new Error(
      "frontend.theme.radius must be 0 or a nonnegative px/rem length",
    );
  if (
    theme.font_family !== undefined &&
    theme.font_family !== "" &&
    (typeof theme.font_family !== "string" ||
      !/^[A-Za-z][A-Za-z0-9 ,\-]{0,119}$/.test(theme.font_family))
  )
    throw new Error(
      "frontend.theme.font_family must be a plain CSS family list",
    );
  if (theme.overrides !== undefined && theme.overrides !== "") {
    const prefix = `${frontend.directory}/src/`;
    const value = theme.overrides;
    if (
      typeof value !== "string" ||
      !value.startsWith(prefix) ||
      !value.endsWith(".css") ||
      value.includes("/generated/") ||
      !value
        .slice(prefix.length, -4)
        .split("/")
        .every((part) => /^[a-z][a-z0-9_-]*$/.test(part))
    )
      throw new Error(
        "frontend.theme.overrides must be a safe CSS file below the frontend src directory, outside generated directories",
      );
  }
  for (const mode of ["light", "dark"]) {
    if (theme[mode] === undefined) continue;
    for (const [key, value] of Object.entries(
      object(theme[mode], `frontend.theme.${mode}`),
    )) {
      if (
        !tokens.has(key) ||
        typeof value !== "string" ||
        !/^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$/.test(value)
      )
        throw new Error(
          `Invalid frontend.theme.${mode} token: ${key}; use #RRGGBB or #RRGGBBAA`,
        );
    }
  }
  return theme;
}

function variable(ui, token) {
  const shadcn = {
    accent: "primary",
    accent_foreground: "primary-foreground",
    surface: "card",
    surface_foreground: "card-foreground",
    muted: "muted-foreground",
    danger: "destructive",
  };
  return `--${ui === "shadcn" ? (shadcn[token] ?? token.replaceAll("_", "-")) : token.replaceAll("_", "-")}`;
}

export function renderTheme(frontend) {
  const theme = validateTheme(frontend);
  let css = banner;
  const shared = [];
  if (theme.radius) shared.push(`  --radius: ${theme.radius};`);
  if (theme.font_family) {
    shared.push(`  --font-sans: ${theme.font_family};`);
    shared.push(`  font-family: ${theme.font_family};`);
  }
  if (shared.length) css += `:root {\n${shared.join("\n")}\n}\n`;
  for (const mode of ["light", "dark"]) {
    const values = Object.entries(theme[mode] ?? {}).sort(([a], [b]) =>
      a.localeCompare(b),
    );
    if (!values.length) continue;
    css += `:root[data-theme="${mode}"] {\n`;
    for (const [key, value] of values)
      css += `  ${variable(frontend.ui, key)}: ${value};\n`;
    css += "}\n";
  }
  const mode = theme.mode || "system";
  const bootstrap = `// Generated by Pluto. Only the public theme mode is emitted.\n(() => {\n  const mode = ${JSON.stringify(mode)};\n  const media = window.matchMedia("(prefers-color-scheme: dark)");\n  const apply = () => {\n    const dark = mode === "dark" || (mode === "system" && media.matches);\n    const root = document.documentElement;\n    root.classList.toggle("dark", dark);\n    root.classList.toggle("light", !dark);\n    root.dataset.theme = dark ? "dark" : "light";\n    root.style.colorScheme = dark ? "dark" : "light";\n  };\n  apply();\n  if (mode === "system") media.addEventListener("change", apply);\n})();\n`;
  const overrides =
    theme.overrides || `${frontend.directory}/src/styles/overrides.css`;
  const relative = path.posix.relative(
    `${frontend.directory}/src/generated`,
    overrides,
  );
  return {
    "src/generated/theme.css": css,
    "src/generated/theme-overrides.css": `${banner}@import ${JSON.stringify(relative)};\n`,
    "public/pluto-theme.js": bootstrap,
  };
}

// No symlink traversal for config, authored imports or generated output.
function safe(root, name) {
  const relative = path.relative(root, name);
  if (relative.startsWith("..") || path.isAbsolute(relative))
    throw new Error("Theme path escapes project");
  let current = root;
  for (const segment of relative.split(path.sep)) {
    current = path.join(current, segment);
    try {
      if (lstatSync(current).isSymbolicLink())
        throw new Error(`Theme symlink refused: ${current}`);
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
  }
  return name;
}

export function syncTheme({ check = false, directory = webRoot } = {}) {
  const root = path.dirname(directory);
  const manifest = parse(
    readFileSync(safe(root, path.join(root, "pluto.toml")), "utf8"),
  );
  const frontend = manifest.frontend;
  if (frontend?.directory !== path.basename(directory))
    throw new Error("Frontend directory does not match pluto.toml");
  const outputs = renderTheme(frontend);
  const overrides =
    frontend.theme?.overrides ||
    `${frontend.directory}/src/styles/overrides.css`;
  const authored = safe(root, path.join(root, overrides));
  if (!lstatSync(authored).isFile())
    throw new Error("Theme overrides must be an existing CSS file");
  // Preflight every destination before writing anything.
  const destinations = Object.entries(outputs).map(([name, content]) => [
    safe(root, path.join(directory, name)),
    content,
  ]);
  for (const [name, expected] of destinations) {
    let actual;
    try {
      actual = readFileSync(name, "utf8");
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
    if (actual === expected) continue;
    if (check)
      throw new Error(
        `Generated theme is stale: ${path.relative(root, name)}. Run npm run theme:generate.`,
      );
    mkdirSync(path.dirname(name), { recursive: true });
    writeFileSync(name, expected);
  }
}

if (
  process.argv[1] &&
  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
) {
  try {
    syncTheme({ check: process.argv.includes("--check") });
  } catch (error) {
    console.error(error.message);
    process.exitCode = 1;
  }
}
