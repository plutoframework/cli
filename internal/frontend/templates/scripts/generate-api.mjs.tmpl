import { readFile, writeFile, mkdir, readdir } from "node:fs/promises";
import openapiTS, { astToString } from "openapi-typescript";
import ts from "typescript";

import path from "node:path";
import { frontendApi, webRoot } from "./manifest.mjs";

// Embedded frontends read the Go application's local contract. Frontend-only
// repositories read [frontend.api].openapi: a relative path or an HTTPS URL.
// External $refs are refused either way. Declarations are split by operation
// group to keep generated files readable.
async function loadContract() {
  const source = frontendApi()?.openapi;
  if (!source)
    return readFile(path.join(webRoot, "../openapi/openapi.json"), "utf8");
  if (!source.includes("://"))
    return readFile(path.resolve(webRoot, source), "utf8");
  const response = await fetch(source, { redirect: "error" });
  if (!response.ok)
    throw new Error(`OpenAPI fetch failed (${response.status}): ${source}`);
  return response.text();
}
const main = JSON.parse(await loadContract());
function assertLocal(value) {
  if (Array.isArray(value)) {
    value.forEach(assertLocal);
    return;
  }
  if (!value || typeof value !== "object") return;
  if (typeof value.$ref === "string" && !value.$ref.startsWith("#/"))
    throw new Error("Only in-document OpenAPI references are allowed");
  Object.values(value).forEach(assertLocal);
}
assertLocal(main);
const document = main;
const declarations = await openapiTS(document);
const result = new Map();
const header =
  "/** Generated from Pluto OpenAPI. Run npm run api:generate; do not edit. */\n";
for (const declaration of declarations) {
  const name = declaration.name?.text;
  if (!name) continue;
  if (name === "operations") {
    const groups = new Map();
    for (const member of declaration.members) {
      const group = member.name.text.split(".")[0];
      if (!groups.has(group)) groups.set(group, []);
      groups.get(group).push(member);
    }
    for (const [group, members] of groups) {
      const updated = ts.factory.updateInterfaceDeclaration(
        declaration,
        declaration.modifiers,
        ts.factory.createIdentifier(`${group}Operations`),
        declaration.typeParameters,
        declaration.heritageClauses,
        members,
      );
      result.set(
        `operations-${group}.ts`,
        header +
          (astToString([updated]).includes("components[")
            ? 'import type { components } from "./components";\n'
            : "") +
          astToString([updated]),
      );
    }
    result.set(
      "operations.ts",
      header +
        [...groups.keys()]
          .map(
            (group) =>
              `import type { ${group}Operations } from "./operations-${group}";`,
          )
          .join("\n") +
        `\nexport interface operations extends ${[...groups.keys()].map((group) => `${group}Operations`).join(", ")} {}\n`,
    );
  } else {
    const imports =
      name === "paths"
        ? 'import type { operations } from "./operations";\n'
        : "";
    result.set(`${name}.ts`, header + imports + astToString([declaration]));
  }
}
const directory = new URL("../src/api/generated/", import.meta.url);
await mkdir(directory, { recursive: true });
const check = process.argv.includes("--check");
for (const [name, content] of result) {
  if (content.split("\n").length > 1000)
    throw new Error(`Generated file exceeds 1000 lines: ${name}`);
  const path = new URL(name, directory);
  if (check) {
    if ((await readFile(path, "utf8").catch(() => "")) !== content)
      throw new Error(`Stale API binding: ${name}; run npm run api:generate`);
  } else await writeFile(path, content);
}
const previous = await readdir(directory);
if (previous.some((name) => !result.has(name)))
  throw new Error(
    "Obsolete generated binding; review and remove it explicitly",
  );
console.log(
  `${check ? "Verified" : "Generated"} ${result.size} API modules from local OpenAPI`,
);
