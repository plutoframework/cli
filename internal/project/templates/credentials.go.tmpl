package transport

import (
	"context"
	"net/http"

	"{{.Module}}/internal/config"

	plutoauth "github.com/plutoframework/pluto-auth"
	"github.com/plutoframework/pluto-auth/httpauth"
	"github.com/plutoframework/pluto-auth/methods/password"
	"github.com/plutoframework/pluto-auth/methods/password/passwordhttp"
)

// LocalDependencies are mandatory application integrations. The store MUST be
// the same fenced account/session backend (postgres.NewLocal), never New.
// Sender must honor context/deadlines; production limits must be shared across
// replicas. Ingress must bound trusted clients, concurrency and queueing before
// decode/KDF. Do not use arbitrary X-Forwarded-For as client identity.
type LocalDependencies struct {
	Store         password.AccountStore
	Sender        password.Sender
	Limiter       password.AttemptLimiter
	Ingress       func(http.Handler) http.Handler
	Policy        password.PasswordPolicy
	DeliveryError func(context.Context, error)
}

func NewLocalAuthentication(ctx context.Context, settings config.Auth,
	memberships MembershipResolver, dependencies LocalDependencies,
) (Authentication, error) {
	if memberships == nil || dependencies.Store == nil ||
		dependencies.Sender == nil ||
		dependencies.Limiter == nil ||
		dependencies.Ingress == nil {
		return Authentication{}, password.ErrInvalidConfig
	}

	hasher, err := password.NewHasher(password.DefaultConfig())
	if err != nil {
		return Authentication{}, err
	}

	sessionConfig := plutoauth.DefaultConfig()
	sessionConfig.TTL = settings.SessionTTL
	sessionConfig.IdleTimeout = settings.IdleTimeout
	lifecycle := password.DefaultLifecycleConfig()
	lifecycle.Policy = dependencies.Policy
	lifecycle.OnDeliveryError = dependencies.DeliveryError

	service, err := password.NewService(ctx, dependencies.Store, hasher,
		dependencies.Limiter, dependencies.Sender, sessionConfig, lifecycle)
	if err != nil {
		return Authentication{}, err
	}

	handler, err := passwordhttp.New(service, passwordhttp.Config{
		Transport: httpauth.Config{
			TrustedOrigins: settings.TrustedOrigins,
			AllowBearer:    true,
			WriteError: func(w http.ResponseWriter, _ *http.Request, status int, code string) {
				JSON(w, status, map[string]string{"code": code})
			},
		},
		Ingress: dependencies.Ingress,
	})
	if err != nil {
		return Authentication{}, err
	}

	return Authentication{
		Accounts:    service,
		Verifier:    sessionPrincipal{memberships: memberships},
		HTTP:        handler.Transport(),
		Manager:     service.Sessions(),
		Credentials: handler,
	}, nil
}
