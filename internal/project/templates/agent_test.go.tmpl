package {{.Group}}

import (
	"context"
	"errors"
	"testing"
	"{{.Module}}/internal/domain"
	models "{{.Module}}/internal/models/{{.OperationGroup}}"
	operations "{{.Module}}/internal/operations/{{.OperationGroup}}"
	agent "github.com/plutoframework/pluto-agent"
	"github.com/plutoframework/pluto-agent/providers/scripted"
)

type operation{{.Action}} struct {
	operations.{{.OperationAction}}Boundary
	calls int
}

func (g *operation{{.Action}}) Authorize(
	_ context.Context,
	p domain.Principal,
) (domain.Principal, error) {
	if !p.Verified() {
		return domain.Principal{}, agent.ErrDenied
	}

	return p, nil
}

func (g *operation{{.Action}}) Execute(
	_ context.Context,
	p domain.Principal,
	input models.{{.OperationAction}}Request,
) ({{.Action}}Result, error) {
	if p.ActorID != "actor" || input.ResourceID != "selected" {
		return {{.Action}}Result{}, agent.ErrDenied
	}

	g.calls++

	return {{.Action}}Result{Value: "Resource"}, nil
}

func Test{{.Action}}RejectsUnverifiedPrincipal(t *testing.T) {
	runner, err := New{{.Action}}(
		scripted.New(scripted.Final(`{"value":"unused"}`)))
	if err != nil {
		t.Fatal(err)
	}

	if _, err := Run{{.Action}}(
		context.Background(),
		runner,
		"denied",
		{{.Action}}Dependencies{},
	); !errors.Is(
		err,
		agent.ErrDenied,
	) {
		t.Fatal(err)
	}
}

func Test{{.Action}}UsesDeclaredOperation(t *testing.T) {
	gate := &operation{{.Action}}{}
	deps := {{.Action}}Dependencies{
		Principal: domain.Principal{
		ActorID: "actor",
{{if .Multi}}
		TenantID: "tenant",
{{end}}
		},
		Operation: gate,
		Input:     models.{{.OperationAction}}Request{ResourceID: "selected"},
	}
	provider := scripted.New(
		scripted.Calls(
			agent.ToolCall{
				ID:        "read",
				Name:      "read_selected_resource",
				Arguments: `{}`,
			}),
		scripted.Final(`{"value":"Review"}`))

	runner, err := New{{.Action}}(provider)
	if err != nil {
		t.Fatal(err)
	}

	result, err := Run{{.Action}}(
		context.Background(),
		runner,
		"selected",
		deps)
	if err != nil || result.Output.Value != "Review" || gate.calls != 1 {
		t.Fatal(result, err, gate.calls)
	}

	// The raw runner cannot issue a model call outside the managed Run wrapper.
	if _, err := runner.Run(
		context.Background(),
		agent.Run[{{.Action}}Dependencies]{
			ID:    "bypass",
			Deps:  deps,
			Input: "bypass",
			Tools: agent.OnlyTools("read_selected_resource"),
		},
	); err == nil {
		t.Fatal("raw runner bypassed managed entry")
	}
}
