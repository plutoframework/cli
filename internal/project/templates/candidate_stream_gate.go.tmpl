package {{.Group}}

import (
	"context"

	"{{.Module}}/internal/access"
	commonDomain "{{.Module}}/internal/domain"
	logic "{{.Module}}/internal/logic/{{.Group}}"
	models "{{.Module}}/internal/models/{{.Group}}"
	"{{.Module}}/internal/scope"
	identitygate "github.com/plutoframework/pluto-rbac/identity"
)

// {{.Action}}Boundary is the sealed entry of a streaming operation. The
// handler authorizes with Prepare before the upgrade, reserves a connection
// with Admit, then hands the accepted connection to Serve, which re-runs the
// gate and drives the stream.
type {{.Action}}Boundary interface {
	sealed{{.Action}}()
	Prepare(
		context.Context,
		access.Caller,
		models.{{.Action}}Request) (*{{.Action}}Intent, error)
	AuthorizeIntent(context.Context, *{{.Action}}Intent) (access.Actor, error)
	Admit() (release func(), ok bool)
	Serve(context.Context, *{{.Action}}Intent, scope.Wire) error
}

// {{.Action}}Intent is normalized once and bound to the exact operation
// instance and verified identity scope. It is not reusable authorization:
// Serve revalidates identity, membership, permission and resource before the
// authored body runs, and the stream rechecks them for its whole lifetime.
type {{.Action}}Intent struct {
	{{lowerFirst .Action}}IntentOwner   *{{.Action}}
	{{lowerFirst .Action}}IntentCaller  access.Caller
	{{lowerFirst .Action}}IntentRequest models.{{.Action}}Request
}

// {{.Action}} gates the authored body logic.{{.Action}}. The body is reachable
// only from this operation's generated workflow.
type {{.Action}} struct {
	{{lowerFirst .Action}}Gate  *identitygate.Gate
	{{lowerFirst .Action}}Ports logic.{{.Action}}Ports
	{{lowerFirst .Action}}Slots chan struct{}
}

func New{{.Action}}(
	gate *identitygate.Gate,
	ports logic.{{.Action}}Ports,
) *{{.Action}} {
	return &{{.Action}}{
		{{lowerFirst .Action}}Gate:  gate,
		{{lowerFirst .Action}}Ports: ports,
		{{lowerFirst .Action}}Slots: make(chan struct{}, {{.Authored.Stream.MaxConnections}}),
	}
}

func (*{{.Action}}) sealed{{.Action}}() {}

func (operation *{{.Action}}) intent(
	caller access.Caller,
	input models.{{.Action}}Request,
) (*{{.Action}}Intent, error) {
	if operation == nil || caller.Identity() == nil {
		return nil, commonDomain.ErrUnauthenticated
	}

	return &{{.Action}}Intent{
		{{lowerFirst .Action}}IntentOwner:   operation,
		{{lowerFirst .Action}}IntentCaller:  caller,
		{{lowerFirst .Action}}IntentRequest: input,
	}, nil
}

func (operation *{{.Action}}) within(
	ctx context.Context,
	intent *{{.Action}}Intent,
	run func(context.Context, *identitygate.Execution) error,
) error {
	if ctx == nil || operation == nil ||
		operation.{{lowerFirst .Action}}Gate == nil ||
		intent == nil ||
		intent.{{lowerFirst .Action}}IntentOwner != operation {
		return commonDomain.ErrUnauthenticated
	}

	caller := intent.{{lowerFirst .Action}}IntentCaller
	if caller.Identity() == nil {
		return commonDomain.ErrUnauthenticated
	}
{{- if .Manifest.DeviceOn}}

	if err := caller.Permits({{q .Authored.Permission}}); err != nil {
		return err
	}

	ctx = scope.ContextWithActor(ctx, caller.Identity())
{{- end}}

	return operation.{{lowerFirst .Action}}Gate.Within(
		ctx,
		caller.Identity(),
		caller.TenantID(),
		{{q .Authored.Resource}},
		run)
}

func (operation *{{.Action}}) Prepare(
	ctx context.Context,
	caller access.Caller,
	input models.{{.Action}}Request,
) (*{{.Action}}Intent, error) {
	intent, err := operation.intent(caller, input)
	if err != nil {
		return nil, err
	}

	if _, err := operation.AuthorizeIntent(ctx, intent); err != nil {
		return nil, err
	}

	return intent, nil
}

func (operation *{{.Action}}) AuthorizeIntent(
	ctx context.Context,
	intent *{{.Action}}Intent,
) (access.Actor, error) {
	var actor access.Actor

	err := operation.within(
		ctx,
		intent,
		func(_ context.Context, execution *identitygate.Execution) error {
			actor = access.Actor{
				SubjectID: execution.SubjectID(),
				TenantID:  execution.TenantID(),
			}

			return nil
		})

	return actor, err
}

// Admit reserves one of this operation's {{.Authored.Stream.MaxConnections}}
// connection slots. The caller releases it when the connection ends.
func (operation *{{.Action}}) Admit() (func(), bool) {
	if operation == nil || operation.{{lowerFirst .Action}}Slots == nil {
		return func() {}, false
	}

	select {
	case operation.{{lowerFirst .Action}}Slots <- struct{}{}:
		return func() { <-operation.{{lowerFirst .Action}}Slots }, true
	default:
		return func() {}, false
	}
}

func (operation *{{.Action}}) Serve(
	ctx context.Context,
	intent *{{.Action}}Intent,
	wire scope.Wire,
) error {
	return operation.within(
		ctx,
		intent,
		func(ctx context.Context, execution *identitygate.Execution) error {
			return operation.execute(
				ctx,
				execution,
				wire,
				intent.{{lowerFirst .Action}}IntentRequest)
		})
}
