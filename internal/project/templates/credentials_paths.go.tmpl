package paths

// These routes are mounted directly through passwordhttp, before tenancy.
// They are never eligible for business response/idempotency caching.
var (
	Enroll = credentialEndpoint(
		"enroll",
		"Enroll account",
		"/auth/enroll",
		PasswordInput{},
		202,
	)
	RequestVerification = credentialEndpoint(
		"verification",
		"Resend verification",
		"/auth/verification",
		EmailInput{},
		202,
	)
	VerifyEmail = credentialEndpoint(
		"verify",
		"Verify email",
		"/auth/verify",
		ChallengeInput{},
		200,
	)
	SignIn = credentialEndpoint(
		"signin",
		"Sign in",
		"/auth/signin",
		PasswordInput{},
		200,
	)
	RequestRecovery = credentialEndpoint(
		"recovery",
		"Request recovery",
		"/auth/recovery",
		EmailInput{},
		202,
	)
	ResetPassword = credentialEndpoint(
		"reset",
		"Reset password",
		"/auth/reset",
		ResetInput{},
		200,
	)
	Logout = credentialEndpoint(
		"logout",
		"Sign out",
		"/auth/logout",
		nil,
		200,
	)
)

func credentialEndpoint(id, name, path string, input any, status int) Endpoint {
	return Endpoint{
		ID:            "credentials." + id,
		Name:          name,
		Description:   "POST only, exact trusted Origin required; opaque code response. No automatic business privileges. JSON is bounded to 8 KiB.",
		Method:        "POST",
		Path:          path,
		Authenticated: id == "logout",
		SessionOnly:   true,
		Request:       input,
		Response:      AuthResult{},
		SuccessStatus: status,
	}
}

func LocalCredentials() []Endpoint {
	return []Endpoint{
		Enroll,
		RequestVerification,
		VerifyEmail,
		SignIn,
		RequestRecovery,
		ResetPassword,
		Logout,
	}
}

// AuthResult deliberately contains no account ID, token or challenge state.
type AuthResult struct {
	Code string `json:"code"`
}

type PasswordInput struct {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type EmailInput struct {
	Email string `json:"email"`
}

type ChallengeInput struct {
	Token string `json:"token"`
}

type ResetInput struct {
	Token    string `json:"token"`
	Password string `json:"password"`
}
