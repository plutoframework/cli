	],
{{if eq .Contract.Kind "effect"}}

	data ports.{{.Resource.Name}}EffectData,
{{else if eq .Contract.Kind "transition"}}
	data ports.{{.Resource.Name}}TransitionData,
{{else if eq .Contract.Kind "create"}}
	data ports.{{.Resource.Name}}CreateData,
{{else if eq .Contract.Kind "list"}}
	data ports.{{.Resource.Name}}ListData,
