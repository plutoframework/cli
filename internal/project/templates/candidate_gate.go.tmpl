func (*{{.Action}}) sealed{{.Action}}() {}

func (operation *{{.Action}}) intent(
	caller access.Caller,
	input models.{{.Action}}Request,
) (*{{.Action}}Intent, error) {
	if operation == nil || caller.Identity() == nil {
		return nil, commonDomain.ErrUnauthenticated
	}

	command, err := domain.New{{.Resource.Name}}Command(
		{{q .Contract.Kind}},
		input.ResourceID,
		input.IdempotencyKey,
		input.Value,
		input.Limit,
		input.Cursor)
	if err != nil {
		return nil, fmt.Errorf("%w: %w", commonDomain.ErrInvalidInput, err)
	}
	{{if eq .Contract.Idempotency "required"}}

	if !idempotency.ValidKey(command.Key()) {
		return nil, fmt.Errorf(
			"%w: %w",
			commonDomain.ErrInvalidInput,
			domain.Err{{.Resource.Name}}Input)
	}
{{else}}
	_ = idempotency.ValidKey
{{end}}

	return &{{.Action}}Intent{
		{{lowerFirst .Action}}IntentOwner:   operation,
		{{lowerFirst .Action}}IntentCaller:  caller,
		{{lowerFirst .Action}}IntentCommand: command,
	}, nil
}

func (operation *{{.Action}}) within(
	ctx context.Context,
	intent *{{.Action}}Intent,
	run func(context.Context, *identitygate.Execution) error,
) error {
	if ctx == nil || operation == nil ||
		operation.{{lowerFirst .Action}}Gate == nil ||
		operation.{{lowerFirst .Action}}Data == nil ||
		intent == nil ||
		intent.{{lowerFirst .Action}}IntentOwner != operation {
		return commonDomain.ErrUnauthenticated
	}

	caller, command := intent.{{lowerFirst .Action}}IntentCaller,
		intent.{{lowerFirst .Action}}IntentCommand
	if caller.Identity() == nil {
		return commonDomain.ErrUnauthenticated
	}

	if err := command.Validate(); err != nil {
		return err
	}
{{if or (eq .Contract.Kind "list") (eq .Contract.Kind "export")}}

	resource := {{q .Resource.ID}}
{{else}}
	resource := command.ID()
{{end}}
	{{if eq .Contract.Kind "effect"}}

	if caller.WorkID() == "" || caller.WorkID() != command.Key() {
		return commonDomain.ErrForbidden
	}

	switch caller.WorkKind() {
{{range .ContractEffects}}{{if eq .Operation $.Contract.ID}}
	case {{q .Kind}}:
{{end}}{{end}}
	default:
		return commonDomain.ErrForbidden
	}
	{{end}}

	return operation.{{lowerFirst .Action}}Gate.Within(
		ctx,
		caller.Identity(),
		caller.TenantID(),
		resource,
		run)
}

func (operation *{{.Action}}) Prepare(
	ctx context.Context,
	caller access.Caller,
	input models.{{.Action}}Request,
) (*{{.Action}}Intent, error) {
	intent, err := operation.intent(caller, input)
	if err != nil {
		return nil, err
	}

	if _, err := operation.AuthorizeIntent(ctx, intent); err != nil {
		return nil, err
	}

	return intent, nil
}

func (operation *{{.Action}}) AuthorizeIntent(
	ctx context.Context,
	intent *{{.Action}}Intent,
) (access.Actor, error) {
	var actor access.Actor

	err := operation.within(
		ctx,
		intent,
		func(_ context.Context, execution *identitygate.Execution) error {
			actor = access.Actor{
				SubjectID: execution.SubjectID(),
				TenantID:  execution.TenantID(),
			}

			return nil
		})

	return actor, err
}

func (operation *{{.Action}}) ExecutePrepared(
	ctx context.Context,
	intent *{{.Action}}Intent,
) (models.{{.Action}}Data, error) {
	var output models.{{.Action}}Data

	err := operation.within(
		ctx,
		intent,
		func(ctx context.Context, execution *identitygate.Execution) error {
			var err error

			output, err = operation.execute(
				ctx,
				execution,
				intent.{{lowerFirst .Action}}IntentCommand)

			return err
		})
	if err != nil {
		return models.{{.Action}}Data{}, err
	}

	return output, nil
}

func (operation *{{.Action}}) Execute(
	ctx context.Context,
	caller access.Caller,
	input models.{{.Action}}Request,
) (models.{{.Action}}Data, error) {
	intent, err := operation.intent(caller, input)
	if err != nil {
		return models.{{.Action}}Data{}, err
	}

	return operation.ExecutePrepared(ctx, intent)
}
