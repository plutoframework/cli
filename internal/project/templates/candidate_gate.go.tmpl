{{else if eq .Contract.Kind "create"}}
	{{lowerFirst .Action}}Data ports.{{.Resource.Name}}CreateData
{{else if eq .Contract.Kind "list"}}
	{{lowerFirst .Action}}Data ports.{{.Resource.Name}}ListData
{{else if eq .Contract.Kind "export"}}
	{{lowerFirst .Action}}Data ports.{{.Resource.Name}}ExportData
{{else}}
