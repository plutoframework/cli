type {{.Action}}Boundary interface {
	sealed{{.Action}}()
	Prepare(
		context.Context,
		access.Caller,
		models.{{.Action}}Request) (*{{.Action}}Intent, error)
	AuthorizeIntent(context.Context, *{{.Action}}Intent) (access.Actor, error)
	ExecutePrepared(
		context.Context,
		*{{.Action}}Intent) (models.{{.Action}}Data, error)
	Execute(
		context.Context,
		access.Caller,
		models.{{.Action}}Request) (models.{{.Action}}Data, error)
}

// {{.Action}}Intent is normalized once and bound to the exact operation
// instance
// and verified identity scope. It is not reusable authorization: every
// execution
// revalidates identity, membership, permission and resource before work.
type {{.Action}}Intent struct {
	{{lowerFirst .Action}}IntentOwner   *{{.Action}}
	{{lowerFirst .Action}}IntentCaller  access.Caller
	{{lowerFirst .Action}}IntentCommand domain.{{.Resource.Name}}Command
}

