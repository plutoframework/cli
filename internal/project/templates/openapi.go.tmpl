// Package api derives OpenAPI from the exact catalog and concrete wire models.
package api

import (
	"bytes"
	"encoding/json"
	"fmt"
	"sort"
	"strconv"
	"strings"

	"{{.Module}}/internal/paths"
)

func Document() ([]byte, error) {
	routes := map[string]map[string]any{}
	for _, endpoint := range paths.All() {
		if routes[endpoint.Path] == nil {
			routes[endpoint.Path] = map[string]any{}
		}

		var responseSchema map[string]any

		var err error

		redirect := endpoint.SuccessStatus >= 300 &&
			endpoint.SuccessStatus < 400
		{{- if .HasStream}}

		if endpoint.Stream != nil {
			routes[endpoint.Path][strings.ToLower(endpoint.Method)], err =
				streamOperation(endpoint)
			if err != nil {
				return nil, fmt.Errorf("%s stream: %w", endpoint.ID, err)
			}

			continue
		}
		{{- end}}

		if !redirect {
			responseSchema, err = modelSchema(endpoint.Response)
			if err != nil {
				return nil, fmt.Errorf("%s response: %w", endpoint.ID, err)
			}
		}

		operation := map[string]any{
			"operationId":  endpoint.ID,
			"summary":      endpoint.Name,
			"description":  endpoint.Description,
			"x-permission": endpoint.Permission,
			"x-feature":    endpoint.Feature,
			"responses": map[string]any{
				strconv.Itoa(endpoint.SuccessStatus): map[string]any{
					"description": "Success",
					"content": map[string]any{
						"application/json": map[string]any{
							"schema": responseSchema,
						},
					},
				},
				"default": map[string]any{
					"description": "Error envelope: code, message, request_" +
						"id. Incomplete operations return 501.",
					"content": map[string]any{
						"application/json": map[string]any{
							"schema": map[string]any{
								"$ref": "#/components/schemas/Error",
							},
						},
					},
				},
			},
		}
		if redirect {
			operation["responses"].(map[string]any)[strconv.Itoa(
				endpoint.SuccessStatus,
			)] = map[string]any{
				"description": "Browser redirect; no JSON success body.",
				"headers": map[string]any{
					"Location": map[string]any{
						"required": true,
						"schema": map[string]any{
							"type":   "string",
							"format": "uri-reference",
						},
					},
				},
			}
		}

		if endpoint.ID == "oidc.begin" {
			schema, err := modelSchema(endpoint.Response)
			if err != nil {
				return nil, err
			}

			operation["responses"].(map[string]any)["200"] = map[string]any{
				"description": "With Accept: application/json, returns a " +
					"server-built authorization URL.",
				"content": map[string]any{
					"application/json": map[string]any{"schema": schema},
				},
			}
		}

		if endpoint.Authenticated {
			operation["security"] = []any{
				map[string]any{"bearerAuth": []string{}},
				map[string]any{"sessionCookie": []string{}},
			}
		}

		{{if .HasMachine}}

		if endpoint.Machine != "" {
			operation["security"] = []any{
				map[string]any{"machineSignature": []string{}},
			}
			operation["x-pluto-machine"] = endpoint.Machine
		}
		{{end}}

		{{if .LocalCredentials}}

		if strings.HasPrefix(endpoint.ID, "credentials.") {
			operation["responses"].(map[string]any)["default"] = map[string]any{
				"description": "Opaque authentication code; no credential " +
					"or challenge data.",
				"content": map[string]any{
					"application/json": map[string]any{"schema": map[string]any{
						"type": "object", "properties": map[string]any{
							"code": map[string]any{
								"type": "string",
							},
						},
						"required": []string{
							"code",
						}, "additionalProperties": false,
					}},
				},
			}
		}
		{{end}}

		if endpoint.Request != nil {
			requestSchema, err := modelSchema(endpoint.Request)
			if err != nil {
				return nil, fmt.Errorf("%s request: %w", endpoint.ID, err)
			}

			operation["requestBody"] = map[string]any{
				"required": true,
				"content": map[string]any{
					"application/json": map[string]any{
						"schema": requestSchema,
					},
				},
			}
		}

		parameters := []any{}
		if endpoint.ID == "oidc.begin" {
			parameters = append(
				parameters,
				map[string]any{
					"name":     "Origin",
					"in":       "header",
					"required": true,
					"schema":   map[string]any{"type": "string"},
				})
		}

		if endpoint.ID == "oidc.callback" {
			for _, name := range []string{"state", "code"} {
				parameters = append(
					parameters,
					map[string]any{
						"name":     name,
						"in":       "query",
						"required": true,
						"schema":   map[string]any{"type": "string"},
					})
			}
		}

		if strings.HasPrefix(endpoint.ID, "oidc.") {
			operation["responses"].(map[string]any)["default"] = map[string]any{
				"description": "Opaque authentication error; no credential " +
					"data.",
				"content": map[string]any{
					"application/json": map[string]any{
						"schema": map[string]any{
							"type": "object",
							"properties": map[string]any{
								"error": map[string]any{
									"type": "object",
									"properties": map[string]any{
										"code": map[string]any{
											"type": "string",
										},
									},
									"required": []string{"code"},
								},
							},
							"required": []string{"error"},
						},
					},
				},
			}
		}

		{{if .LocalCredentials}}

		if strings.HasPrefix(endpoint.ID, "credentials.") {
			parameters = append(
				parameters,
				map[string]any{
					"name":     "Origin",
					"in":       "header",
					"required": true,
					"schema":   map[string]any{"type": "string"},
				})
		}
		{{end}}

		for _, part := range strings.Split(endpoint.Path, "/") {
			if strings.HasPrefix(part, "{") {
				name := strings.Trim(part, "{}")
				parameters = append(
					parameters,
					map[string]any{
						"name":     name,
						"in":       "path",
						"required": true,
						"schema":   pathSchema(endpoint.Params, name),
					},
				)
			}
		}

		if endpoint.Collection {
			parameters = append(
				parameters,
				map[string]any{
					"name": "limit",
					"in":   "query",
					"schema": map[string]any{
						"type":    "integer",
						"default": 25,
						"minimum": 1,
						"maximum": 100,
					},
				},
				map[string]any{
					"name": "cursor",
					"in":   "query",
					"schema": map[string]any{
						"type":      "string",
						"maxLength": 2048,
					},
				})
		}

		for _, param := range endpoint.Query {
			parameters = append(parameters, queryParameter(param))
		}

		if endpoint.Idempotent {
			parameters = append(
				parameters,
				map[string]any{
					"name":        "Idempotency-Key",
					"in":          "header",
					"required":    true,
					"description": "Client retry key; 409 means conflict " +
						"or pending reconciliation. 24h completed retention.",
					"schema": map[string]any{
						"type":      "string",
						"minLength": 1,
						"maxLength": 128,
						"pattern":   "^[A-Za-z0-9_.:-]+$",
					},
				})
		}

		if len(parameters) > 0 {
			operation["parameters"] = parameters
		}

		routes[endpoint.Path][strings.ToLower(endpoint.Method)] = operation
	}

	document := map[string]any{
		"openapi": "3.1.0",
		"info":    map[string]any{"title": {{q .Name}}, "version": "0.1.0"},
		"paths":   routes,
		"components": map[string]any{
			"securitySchemes": map[string]any{
				"sessionCookie": map[string]any{
					"type": "apiKey",
					"in":   "cookie",
					"name": "__Host-pluto_session",
				},
				"bearerAuth": map[string]any{
					"type":   "http",
					"scheme": "bearer",
				},
{{- if .HasMachine}}
				"machineSignature": map[string]any{
					"type":        "apiKey",
					"in":          "header",
					"name":        "X-Pluto-Signature",
					"description": "Ed25519 signature with X-Pluto-Machine-ID, X-Pluto-Timestamp and X-Pluto-Nonce over the pluto-machine-v1 canonical request.",
				},
{{- end}}
			},
			"schemas": map[string]any{
				"Error": map[string]any{
					"type": "object",
					"properties": map[string]any{
						"error": map[string]any{
							"type": "object",
							"properties": map[string]any{
								"code":       map[string]any{"type": "string"},
								"message":    map[string]any{"type": "string"},
								"request_id": map[string]any{"type": "string"},
							},
						},
					},
				},
			},
		},
	}

	return encodeDocument(document)
}

// pathSchema is the declared type of a path parameter; an undeclared one
// (a generated record route) stays a plain string.
func pathSchema(params []paths.PathParam, name string) map[string]any {
	for _, param := range params {
		if param.Name != name {
			continue
		}

		switch param.Type {
		case "uuid":
			return map[string]any{"type": "string", "format": "uuid"}
		case "int64":
			schema := map[string]any{"type": "integer", "minimum": 0}
			if param.Max > 0 {
				schema["maximum"] = param.Max
			}

			return schema
		default:
			return map[string]any{
				"type":      "string",
				"minLength": 1,
				"maxLength": param.Max,
				"pattern":   "^[A-Za-z0-9._~-]+$",
			}
		}
	}

	return map[string]any{"type": "string"}
}

func queryParameter(param paths.QueryParam) map[string]any {
	schema := map[string]any{"type": "string"}

	switch param.Type {
	case "string":
		schema["maxLength"] = param.Max
	case "int64":
		schema = map[string]any{"type": "integer", "minimum": 0}
		if param.Max > 0 {
			schema["maximum"] = param.Max
		}
	case "bool":
		schema = map[string]any{"type": "boolean"}
	case "time":
		schema["format"] = "date-time"
	}

	parameter := map[string]any{
		"name":   param.Name,
		"in":     "query",
		"schema": schema,
	}
	if param.After != "" {
		parameter["x-after"] = param.After
	}

	return parameter
}

// encodeDocument indents nested JSON but keeps objects and arrays that fit in
// 80 columns on one line, so the reviewed artifact stays within file limits.
// Keys are sorted, so output is deterministic and freshness checks stay exact.
func encodeDocument(document any) ([]byte, error) {
	data, err := json.Marshal(document)
	if err != nil {
		return nil, err
	}

	var tree any

	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.UseNumber()

	if err := decoder.Decode(&tree); err != nil {
		return nil, err
	}

	var output bytes.Buffer
	if err := writeJSON(&output, tree, 0, 0); err != nil {
		return nil, err
	}

	output.WriteByte('\n')

	return output.Bytes(), nil
}

func writeJSON(output *bytes.Buffer, value any, depth, prefix int) error {
	inline, err := json.Marshal(value)
	if err != nil {
		return err
	}

	object, isObject := value.(map[string]any)
	array, isArray := value.([]any)

	if !isObject && !isArray || depth*2+prefix+len(inline)+1 <= 80 {
		output.Write(inline)

		return nil
	}

	indent := strings.Repeat("  ", depth+1)

	if isArray {
		output.WriteString("[\n")

		for index, item := range array {
			output.WriteString(indent)

			if err := writeJSON(output, item, depth+1, 0); err != nil {
				return err
			}

			if index < len(array)-1 {
				output.WriteByte(',')
			}

			output.WriteByte('\n')
		}

		output.WriteString(strings.Repeat("  ", depth) + "]")

		return nil
	}

	keys := make([]string, 0, len(object))
	for key := range object {
		keys = append(keys, key)
	}

	sort.Strings(keys)
	output.WriteString("{\n")

	for index, key := range keys {
		name, err := json.Marshal(key)
		if err != nil {
			return err
		}

		output.WriteString(indent)
		output.Write(name)
		output.WriteString(": ")

		if err := writeJSON(
			output,
			object[key],
			depth+1,
			len(name)+2,
		); err != nil {
			return err
		}

		if index < len(keys)-1 {
			output.WriteByte(',')
		}

		output.WriteByte('\n')
	}

	output.WriteString(strings.Repeat("  ", depth) + "}")

	return nil
}
{{if .HasStream}}
// streamOperation documents a WebSocket upgrade: the HTTP handshake is the
// operation and the JSON messages of each direction are extensions, since
// OpenAPI has no native WebSocket model.
func streamOperation(endpoint paths.Endpoint) (map[string]any, error) {
	spec := endpoint.Stream

	server, err := modelSchema(spec.Server)
	if err != nil {
		return nil, err
	}

	messages := map[string]any{
		"server_to_client": server,
		"max_message_bytes": spec.MaxMessageBytes,
	}

	if spec.Client != nil {
		client, err := modelSchema(spec.Client)
		if err != nil {
			return nil, err
		}

		messages["client_to_server"] = client
	}

	if len(spec.Origins) > 0 {
		messages["allowed_origins"] = spec.Origins
	}

	parameters := []any{}

	for _, param := range endpoint.Query {
		parameters = append(parameters, queryParameter(param))
	}

	return map[string]any{
		"operationId":  endpoint.ID,
		"summary":      endpoint.Name,
		"description": endpoint.Description + " JSON text frames, one " +
			"object each. Clients without X-Tenant-ID (browsers) pass tenant " +
			"as a query parameter; the gate verifies membership.",
		"x-permission": endpoint.Permission,
		"x-websocket":  messages,
		"security": []any{
			map[string]any{"bearerAuth": []string{}},
			map[string]any{"sessionCookie": []string{}},
		},
		"parameters": parameters,
		"responses": map[string]any{
			"101": map[string]any{
				"description": "Switching Protocols: WebSocket upgrade. " +
					"Authentication and authorization run before the " +
					"upgrade; the stream closes when they are revoked.",
			},
			"default": map[string]any{
				"description": "Error envelope: code, message, request_id. " +
					"Returned before the upgrade (401, 403, 400, 503 " +
					"stream_capacity).",
				"content": map[string]any{
					"application/json": map[string]any{
						"schema": map[string]any{
							"$ref": "#/components/schemas/Error",
						},
					},
				},
			},
		},
	}, nil
}
{{end}}
