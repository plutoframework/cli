package app

import (
	"context"
	"errors"
	"net/http"

	"github.com/go-chi/chi/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	authpostgres "github.com/plutoframework/pluto-auth/stores/postgres"
{{- if .OIDC}}
	"github.com/plutoframework/pluto-auth/httpauth"
	"github.com/plutoframework/pluto-auth/methods/oidc"
	"github.com/plutoframework/pluto-auth/methods/oidc/oidchttp"
	oidcpostgres "github.com/plutoframework/pluto-auth/stores/postgres/oidc"
{{- end}}

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/auth/credentials"
	"{{.Module}}/internal/paths"
	"{{.Module}}/internal/transport"
)

// newCandidateAuthentication composes the only session issuer. Password and
// OIDC sign-in create sessions through the same fenced manager that issues
// opaque identities to operation gates. No subject string is accepted.
func newCandidateAuthentication(
	ctx context.Context,
	cfg config.Config,
	pool *pgxpool.Pool,
	memberships transport.MembershipResolver,
	integrations credentials.Integrations,
) (transport.Authentication, error) {
	if ctx == nil || pool == nil || memberships == nil {
		return transport.Authentication{}, errors.New(
			"invalid candidate credential composition")
	}

	store, err := authpostgres.NewLocal(pool)
	if err != nil {
		return transport.Authentication{}, err
	}

	authentication, err := transport.NewLocalAuthentication(
		ctx,
		cfg.Auth,
		memberships,
		transport.LocalDependencies{
			Store:         store,
			Sender:        integrations.Sender,
			Limiter:       integrations.Limiter,
			Ingress:       integrations.Ingress,
			Policy:        integrations.Policy,
			DeliveryError: integrations.DeliveryError,
		},
	)
	if err != nil {
		return transport.Authentication{}, err
	}
{{- if .OIDC}}

	authentication.OIDC, err = newCandidateOIDC(
		ctx,
		cfg,
		pool,
		authentication,
		integrations.Ingress,
	)
	if err != nil {
		return transport.Authentication{}, err
	}
{{- end}}

	return authentication, nil
}
{{- if .OIDC}}

func newCandidateOIDC(
	ctx context.Context,
	cfg config.Config,
	pool *pgxpool.Pool,
	authentication transport.Authentication,
	ingress func(http.Handler) http.Handler,
) (http.Handler, error) {
	if !cfg.OIDC.Enabled {
		return nil, nil
	}

	pending, err := oidcpostgres.New(pool, cfg.OIDC.EncryptionKey, 10000)
	if err != nil {
		return nil, errors.New("OIDC persistence configuration failed")
	}

	client, err := oidc.New(ctx, oidc.Config{
		Issuer:       cfg.OIDC.Issuer,
		ClientID:     cfg.OIDC.ClientID,
		ClientSecret: cfg.OIDC.ClientSecret,
		RedirectURL:  cfg.OIDC.CallbackURL,
		Transactions: pending,
	})
	if err != nil {
		return nil, errors.New("OIDC provider configuration failed")
	}

	service, err := oidc.NewService(
		client,
		pending,
		authentication.Manager,
		cfg.OIDC.AllowEnrollment,
	)
	if err != nil {
		return nil, errors.New("OIDC authentication configuration failed")
	}

	return oidchttp.New(service, oidchttp.Config{
		Transport: httpauth.Config{
			TrustedOrigins: cfg.Auth.TrustedOrigins,
		},
		Ingress:         ingress,
		SuccessPath:     "/",
		CookieNamespace: cfg.OIDC.Issuer + ":" + cfg.OIDC.ClientID,
	})
}
{{- end}}

// registerCandidateCredentials mounts the published password lifecycle and
// optional OIDC sign-in. Business routes never pass through these handlers.
func registerCandidateCredentials(
	router chi.Router,
	authentication transport.Authentication,
{{- if .Manifest.AuthEventsOn}}
	events authEvents,
{{- end}}
) {
	if authentication.Credentials != nil {
		for _, endpoint := range paths.LocalCredentials() {
{{- if .Manifest.AuthEventsOn}}
			handler := http.StripPrefix("/auth", authentication.Credentials)

			switch endpoint.ID {
			case paths.SignIn.ID:
				handler = events.signedIn("{{.LoginKind}}", handler)
			case paths.Logout.ID:
				handler = events.signingOut(handler)
			}

			router.Method(endpoint.Method, endpoint.Path, handler)
{{- else}}
			router.Method(
				endpoint.Method,
				endpoint.Path,
				http.StripPrefix("/auth", authentication.Credentials),
			)
{{- end}}
		}
	}
{{- if .OIDC}}

	if authentication.OIDC != nil {
{{- if .Manifest.AuthEventsOn}}
		oidcHandler := http.StripPrefix("/auth/oidc", authentication.OIDC)
		oidcHandler = events.signedIn("{{.OIDCLoginKind}}", oidcHandler)

		router.Mount("/auth/oidc", oidcHandler)
{{- else}}
		router.Mount(
			"/auth/oidc",
			http.StripPrefix("/auth/oidc", authentication.OIDC),
		)
{{- end}}
	}

	router.Get(
		paths.OIDCProviders.Path,
		func(w http.ResponseWriter, r *http.Request) {
			providers := []string{}
			if authentication.OIDC != nil {
				providers = append(providers, "oidc")
			}

			transport.JSON(w, 200, paths.OIDCProviderList{Data: providers})
		},
	)
{{- end}}
}
