type fake{{.Action}} struct{ calls int }

func (f *fake{{.Action}}) Execute(
	_ context.Context,
	_ domain.Principal,
	input {{.Group}}.{{.Action}}Request,
) ({{.Group}}.{{.Action}}Data, error) {
	f.calls++
	return {{.Group}}.{{.Action}}Data{Value: input.Value}, nil
}

