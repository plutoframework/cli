func Test{{.Action}}HTTP(t *testing.T) {
	router := chi.NewRouter()
	operation := &fake{{.Action}}{}
	enabled := true
	evaluator := features.New(map[string]*bool{ {{q .Feature}}: &enabled})
	reg := transport.Registrar{
		Router:   router,
		Auth:     auth{{.Action}}{},
		Features: evaluator,
		Logger:   slog.New(slog.NewTextHandler(io.Discard, nil)),
	}
	Register{{.Action}}(reg, operation, 16*1024)

	request := httptest.NewRequest(
		paths.{{.Symbol}}.Method,
		{{q .TestPath}},
		strings.NewReader(`{"value":"verified"}`),
	)
	request.Header.Set("Authorization", "Bearer verified")

	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)

	if response.Code != 200 || operation.calls != 1 {
		t.Fatalf(
			"status=%d calls=%d body=%s",
			response.Code,
			operation.calls,
			response.Body,
		)
	}

{{if not .Public}}
	request = httptest.NewRequest(
		paths.{{.Symbol}}.Method,
		{{q .TestPath}},
		strings.NewReader(`{"value":"verified"}`),
	)
	response = httptest.NewRecorder()
	router.ServeHTTP(response, request)

	if response.Code != 401 || operation.calls != 1 {
		t.Fatal("unverified caller reached operation")
	}
{{end}}
}

// Fuzz{{.Action}}Boundary verifies denied requests cannot call operations.
func Fuzz{{.Action}}Boundary(f *testing.F) {
	f.Add("Bearer invalid", `{"unknown":true}`)
	f.Add("", `{} {}`)
	f.Fuzz(func(t *testing.T, authorization, body string) {
		if len(body) > 32*1024 {
			t.Skip()
		}

		router := chi.NewRouter()
		operation := &fake{{.Action}}{}
		reg := transport.Registrar{
			Router:   router,
			Auth:     transport.DenyAll{},
			Features: features.New(nil),
			Logger:   slog.New(slog.NewTextHandler(io.Discard, nil)),
		}
		Register{{.Action}}(reg, operation, 16*1024)

		request := httptest.NewRequest(
			paths.{{.Symbol}}.Method,
			{{q .TestPath}},
			strings.NewReader(body),
		)
		request.Header.Set("Authorization", authorization)

		response := httptest.NewRecorder()
		router.ServeHTTP(response, request)

{{if not .Public}}		if operation.calls != 0 || response.Code != 401 {
			t.Fatal("deny-all invariant violated")
		}{{else}}
 if operation.calls>1 || response.Code>=500 { t.Fatal("public boundary failed") }
{{end}}
	})
}
