package main

import (
	"context"
	"errors"

	"{{.Module}}/internal/access"
	"{{.Module}}/internal/config"
	"{{.Module}}/internal/transport"

	"github.com/jackc/pgx/v5/pgxpool"
	authpostgres "github.com/plutoframework/pluto-auth/stores/postgres"
)

func newLocalAuthentication(ctx context.Context, cfg config.Config,
	pool *pgxpool.Pool,
) (transport.Authentication, error) {
	dependencies, err := localIntegrations(ctx, cfg)
	if err != nil {
		return transport.Authentication{}, err
	}

	store, err := authpostgres.NewLocal(pool)
	if err != nil {
		return transport.Authentication{}, err
	}

	dependencies.Store = store

	return transport.NewLocalAuthentication(ctx, cfg.Auth,
		access.Memberships{}, dependencies)
}

// Implement this authored seam with real bounded delivery, shared identifier
// limits and trusted-client/concurrency ingress. Missing integrations stop
// startup; no sender, memory store, fixture password or role is substituted.
// Deliver only to fixed trusted HTTPS confirmation destinations, never Host or
// arbitrary return URLs. Never log Notification or persist plaintext tokens.
func localIntegrations(
	_ context.Context,
	_ config.Config,
) (transport.LocalDependencies, error) {
	return transport.LocalDependencies{}, errors.New(
		"local credentials require application Sender, shared AttemptLimiter and trusted-client Ingress in cmd/api/credentials.go",
	)
}
