// Package transport holds provisional app-local HTTP primitives.
package transport

import (
	"encoding/json"
 "bytes"
	"errors"
	"io"
	"net/http"

	"{{.Module}}/internal/domain"

	"github.com/go-chi/chi/v5/middleware"
)

type ErrorEnvelope struct {
	Error ErrorBody `json:"error"`
}
type ErrorBody struct {
	Code      string `json:"code"`
	Message   string `json:"message"`
	RequestID string `json:"request_id"`
}

func JSON(w http.ResponseWriter, status int, value any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)

	// Transport write errors cannot be recovered after headers are sent.
	_ = json.NewEncoder(w).Encode(value)
}

func Error(w http.ResponseWriter, r *http.Request, status int, code string) {
	JSON(w, status, ErrorEnvelope{Error: ErrorBody{
		Code:      code,
		Message:   http.StatusText(status),
		RequestID: middleware.GetReqID(r.Context()),
	}})
}

func OperationError(w http.ResponseWriter, r *http.Request, err error) {
	if errors.Is(err, domain.ErrNotImplemented) {
		Error(w, r, http.StatusNotImplemented, "not_implemented")

		return
	}

	Error(w, r, http.StatusInternalServerError, "internal_error")
}

// Decode bounds input and rejects unknown fields, invalid types and extra JSON.
// Empty bodies are invalid for body-bearing endpoints. Duplicate known JSON keys
// follow encoding/json's last-value semantics; no stricter claim is made.
func Decode(
	w http.ResponseWriter,
	r *http.Request,
	target any,
	limit int64,
) bool {
	body := http.MaxBytesReader(w, r.Body, limit)
	defer body.Close()

 data,err:=io.ReadAll(body)
 if err==nil && (len(bytes.TrimSpace(data))==0 || bytes.TrimSpace(data)[0]!='{') {
  err=errors.New("expected JSON object")
 }
 if err==nil {
  decoder:=json.NewDecoder(bytes.NewReader(data))
  decoder.DisallowUnknownFields()
  err=decoder.Decode(target)
  if err==nil {
   var extra any
   trailing:=decoder.Decode(&extra)
   if !errors.Is(trailing,io.EOF) {
    err=trailing
    if err==nil { err=errors.New("extra JSON") }
   }
  }
 }

	if err != nil {
		var oversized *http.MaxBytesError
		if errors.As(err, &oversized) {
			Error(w, r, http.StatusRequestEntityTooLarge, "body_too_large")
		} else {
			Error(w, r, http.StatusBadRequest, "invalid_json")
		}

		return false
	}

	return true
}
