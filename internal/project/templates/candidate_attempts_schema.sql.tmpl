-- Replica-shared local-credential attempt windows. Keys are SHA-256 digests.
-- Apply explicitly with the other migrations. No startup DDL.
CREATE TABLE pluto_credential_attempts (
    key_digest bytea PRIMARY KEY CHECK (octet_length(key_digest) = 32),
    attempts integer NOT NULL CHECK (attempts > 0),
    expires_at timestamptz NOT NULL
);

CREATE INDEX pluto_credential_attempts_expires_at
    ON pluto_credential_attempts (expires_at);
