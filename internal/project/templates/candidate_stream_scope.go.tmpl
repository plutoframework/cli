// MemoryPeer is the remote end of an in-memory stream used by scopetest.
type MemoryPeer struct {
	scopePeerToServer chan []byte
	scopePeerToClient chan []byte
	scopePeerClosed   chan struct{}
	scopePeerOnce     sync.Once
}

type memory struct {
	scopeMemoryPeer *MemoryPeer
}

// NewMemoryWire is a capability: only the scope test harness may call it. It
// returns a Wire backed by memory and the peer that drives it.
func NewMemoryWire() (Wire, *MemoryPeer) {
	peer := &MemoryPeer{
		scopePeerToServer: make(chan []byte, inboundBuffer),
		scopePeerToClient: make(chan []byte, inboundBuffer),
		scopePeerClosed:   make(chan struct{}),
	}

	return Wire{scopeWireTransport: memory{scopeMemoryPeer: peer}}, peer
}

// Send delivers one raw client message to the server side.
func (p *MemoryPeer) Send(ctx context.Context, message []byte) error {
	select {
	case p.scopePeerToServer <- message:
		return nil
	case <-p.scopePeerClosed:
		return ErrStreamClosed
	case <-ctx.Done():
		return ctx.Err()
	}
}

// Receive returns the next raw server message or ErrStreamClosed.
func (p *MemoryPeer) Receive(ctx context.Context) ([]byte, error) {
	select {
	case message := <-p.scopePeerToClient:
		return message, nil
	case <-p.scopePeerClosed:
		select {
		case message := <-p.scopePeerToClient:
			return message, nil
		default:
			return nil, ErrStreamClosed
		}
	case <-ctx.Done():
		return nil, ctx.Err()
	}
}

// Close ends the stream from the client side.
func (p *MemoryPeer) Close() {
	p.scopePeerOnce.Do(func() { close(p.scopePeerClosed) })
}

func (memory) limit(int64) {}

func (m memory) read(ctx context.Context) ([]byte, error) {
	select {
	case message := <-m.scopeMemoryPeer.scopePeerToServer:
		return message, nil
	default:
	}

	select {
	case message := <-m.scopeMemoryPeer.scopePeerToServer:
		return message, nil
	case <-m.scopeMemoryPeer.scopePeerClosed:
		return nil, ErrStreamClosed
	case <-ctx.Done():
		return nil, ctx.Err()
	}
}

func (m memory) write(ctx context.Context, message []byte) error {
	select {
	case m.scopeMemoryPeer.scopePeerToClient <- message:
		return nil
	case <-m.scopeMemoryPeer.scopePeerClosed:
		return ErrStreamClosed
	case <-ctx.Done():
		return ctx.Err()
	}
}

func (memory) ping(context.Context) error { return nil }

func (m memory) close(int, string) { m.scopeMemoryPeer.Close() }
