package {{.Group}}

import (
	"context"

	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/models/{{.Group}}"
{{if .Permission}}	"{{.Module}}/internal/access"
{{end}}
	rbac "github.com/plutoframework/pluto-rbac"
)

type {{.Action}} struct {
	policy *rbac.Policy
}

func New{{.Action}}(policy *rbac.Policy) *{{.Action}} {
	return &{{.Action}}{policy: policy}
}

// Execute must enforce resource authorization and tenant-scoped repositories.
// A route permission is a capability check, not resource authorization.
func (operation *{{.Action}}) Execute(
	_ context.Context,
	principal domain.Principal,
	_ {{.Group}}.{{.Action}}Request,
) ({{.Group}}.{{.Action}}Data, error) {
{{if not .Public}}	if !principal.Verified() {
		return {{.Group}}.{{.Action}}Data{}, domain.ErrUnauthenticated
	}
{{end}}
{{if .Permission}}	if !principal.Can(operation.policy, access.{{.Symbol}}Permission) {
		return {{.Group}}.{{.Action}}Data{}, domain.ErrForbidden
	}
{{end}}
	return {{.Group}}.{{.Action}}Data{}, domain.ErrNotImplemented
}
