package {{.Group}}

import (
	"context"

	logic "{{.Module}}/internal/logic/{{.Group}}"
	"{{.Module}}/internal/scope"
	identitygate "github.com/plutoframework/pluto-rbac/identity"
)

// execute is the only caller of the authored body. It binds the
// callback-scoped execution of one tenant to this job's gate and fixed
// resource, so every data access the body makes revalidates the service
// session, the tenant, the service role's permission and the resource policy.
func (job *{{.Action}}) execute(
	ctx context.Context,
	execution *identitygate.Execution,
) error {
	return logic.{{.Action}}(
		ctx,
		scope.Bind(
			execution,
			job.{{lowerFirst .Action}}Gate,
			{{lowerFirst .Action}}Resource),
		job.{{lowerFirst .Action}}Ports)
}
