package postgres

import (
	"context"
	"time"

	"github.com/jackc/pgx/v5/pgxpool"
    "github.com/jackc/pgx/v5"
)

// Open verifies connectivity only. Generated operation stubs do not persist data.
// Add explicit domain-specific repositories with tenant predicates when needed.
func Open(ctx context.Context, url string) (*pgxpool.Pool, error) {
	return OpenWithTracer(ctx, url, nil)
}

// OpenWithTracer configures query tracing before any connections are opened.
func OpenWithTracer(ctx context.Context, url string, tracer pgx.QueryTracer) (*pgxpool.Pool, error) {
    ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()

	cfg, err := pgxpool.ParseConfig(url)
    if err != nil { return nil, err }
    cfg.ConnConfig.Tracer = tracer
    pool, err := pgxpool.NewWithConfig(ctx, cfg)
	if err != nil {
		return nil, err
	}

	if err := pool.Ping(ctx); err != nil {
		pool.Close()

		return nil, err
	}

	return pool, nil
}
