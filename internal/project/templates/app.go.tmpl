package app

import (
	"log/slog"
	"net/http"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/features"
	"{{.Module}}/internal/paths"
	"{{.Module}}/internal/transport"

	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
	rbac "github.com/plutoframework/pluto-rbac"
)

func New(
	cfg config.Config,
	authentication transport.Authentication,
	logger *slog.Logger,
	policy *rbac.Policy,
) http.Handler {
	evaluator := features.New(cfg.Features)
	router := chi.NewRouter()
	router.Use(middleware.RequestID)
	router.Use(transport.SecurityHeaders)
	router.Use(transport.Recover(logger))
	router.Use(func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.Header().Set("X-Request-ID", middleware.GetReqID(r.Context()))
			next.ServeHTTP(w, r)
		})
	})

	if cfg.Server.Gzip {
		router.Use(middleware.Compress(5, "application/json"))
	}

	reg := transport.Registrar{
		Router:   router,
		Auth:     authentication.Verifier,
 Sessions: authentication.HTTP,
 Idempotency: authentication.Idempotency,
		Features: evaluator,
		Logger:   logger,
		Policy:   policy,
	}
	reg.Handle(paths.Health, func(w http.ResponseWriter, _ *http.Request) {
		transport.JSON(
			w,
			paths.Health.SuccessStatus,
			paths.HealthResponse{Data: "ok"},
		)
	})
	reg.Handle(paths.GetFeatures, func(w http.ResponseWriter, _ *http.Request) {
		transport.JSON(
			w,
			paths.GetFeatures.SuccessStatus,
			paths.FeaturesResponse{Data: evaluator.Visible()},
		)
	})
	{{if .LocalCredentials}}
    if authentication.Credentials != nil {
        for _, endpoint := range paths.LocalCredentials() {
            router.Method(endpoint.Method, endpoint.Path,
                http.StripPrefix("/auth", authentication.Credentials))
        }
    }
    {{end}}
    transport.RegisterSessions(reg,authentication)
 RegisterGenerated(reg, Dependencies{Config: cfg, Policy: policy})
	router.NotFound(
		func(w http.ResponseWriter, r *http.Request) { transport.Error(w, r, 404, "not_found") },
	)
	router.MethodNotAllowed(
		func(w http.ResponseWriter, r *http.Request) { transport.Error(w, r, 405, "method_not_allowed") },
	)

	return router
}
