// Package scope is the generated, app-local capability surface authored role
// packages receive. It is provisional and not a published Pluto API.
//
// Authored code can neither construct nor convert any type here: an Execution
// exists only inside its gate callback, a Tenant is obtainable only from an
// Execution or Tx, and a Tx exists only inside DB.Read or DB.Write, which
// recheck the live gate before opening a transaction.
package scope

import (
	"context"
{{- if .HasProvision}}
	"crypto/rand"
{{- end}}
	"database/sql/driver"
{{- if .HasProvision}}
	"encoding/hex"
{{- end}}
	"encoding/json"
	"errors"
	"fmt"
{{- if .HasProvision}}
	"sync"
{{- end}}
	"time"
{{- if .HasProvision}}

	auth "github.com/plutoframework/pluto-auth"
{{- else}}
{{end}}
	jobs "github.com/plutoframework/pluto-jobs"
	jobspostgres "github.com/plutoframework/pluto-jobs/stores/postgres"
	identitygate "github.com/plutoframework/pluto-rbac/identity"
{{- if .HasMachine}}

	machineauth "{{.Module}}/internal/ports/machineauth"
	machinestore "{{.Module}}/internal/storage/machineauth"
{{- end}}

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

// ErrNoTenant rejects a zero Tenant or Execution.
var ErrNoTenant = errors.New("scope: no verified tenant")

// ErrUnsupported reports a capability whose generator is not available yet.
var ErrUnsupported = errors.New("scope: capability not supported")

// Execution is the only identity an authored body sees: no constructor, the
// zero value denies, and it is valid only inside its gate callback.
type Execution struct {
	scopeExecution *identitygate.Execution
	scopeGate      *identitygate.Gate
	scopeResource  string
{{- if .HasMachine}}

	// scopeMachine is set instead of scopeExecution for a machine caller.
	scopeMachine *machineauth.Verified
{{- end}}
}

// SubjectID is the verified acting subject and the only legitimate actor
// source for authored code. Never take an actor from request input.
func (e Execution) SubjectID() string {
{{- if .HasMachine}}
	if e.scopeMachine != nil {
		return e.scopeMachine.MachineID()
	}
{{end}}
	if e.scopeExecution == nil {
		return ""
	}

	return e.scopeExecution.SubjectID()
}

// Tenant is the verified tenant of this execution.
func (e Execution) Tenant() Tenant {
{{- if .HasMachine}}
	if e.scopeMachine != nil {
		return Tenant{scopeTenant: e.scopeMachine.TenantID()}
	}
{{end}}
	if e.scopeExecution == nil {
		return Tenant{}
	}

	return Tenant{scopeTenant: e.scopeExecution.TenantID()}
}

// Tenant is the sqlc go_type of every declared tenant column. Authored code
// cannot build one, so every tenant-scoped query argument is the verified
// tenant. Scanning a result column never produces a usable value.
type Tenant struct {
	scopeTenant string
}

// Value implements driver.Valuer and rejects an empty tenant.
func (t Tenant) Value() (driver.Value, error) {
	if t.scopeTenant == "" {
		return nil, ErrNoTenant
	}

	return t.scopeTenant, nil
}

// Scan accepts a tenant column read back from the database and discards it. A
// scanned value never becomes a usable Tenant, so Scan cannot forge one.
func (t *Tenant) Scan(value any) error {
	switch value.(type) {
	case nil, string, []byte:
		return nil
	}

	return fmt.Errorf("scope: unsupported tenant column type %T", value)
}

// String is for diagnostics only.
func (t Tenant) String() string {
	return t.scopeTenant
}

// DB opens gate-rechecked tenant transactions. It holds the pool privately.
type DB struct {
	scopeDBPool *pgxpool.Pool
	scopeDBJobs *jobspostgres.Store
}

// Tx is one open tenant-scoped transaction.
type Tx struct {
	scopeTx      pgx.Tx
	scopeTenant  Tenant
	scopeSubject string
	scopeJobs    *jobspostgres.Store
}

// Tenant is the verified tenant this transaction is bound to.
func (t Tx) Tenant() Tenant {
	return t.scopeTenant
}

// SubjectID is the verified acting subject of the execution that opened this
// transaction. A method that joins another operation's transaction attributes
// its writes to it instead of trusting an actor argument.
func (t Tx) SubjectID() string {
	return t.scopeSubject
}

// Read rechecks the live gate, opens a read-only transaction and binds
// app.tenant_id for row-level security.
func (d DB) Read(
	ctx context.Context,
	e Execution,
	run func(context.Context, Tx) error,
) error {
	return d.within(ctx, e, pgx.ReadOnly, run)
}

// Write is Read with a read-write transaction.
func (d DB) Write(
	ctx context.Context,
	e Execution,
	run func(context.Context, Tx) error,
) error {
	return d.within(ctx, e, pgx.ReadWrite, run)
}

func (d DB) within(
	ctx context.Context,
	e Execution,
	mode pgx.TxAccessMode,
	run func(context.Context, Tx) error,
) error {
{{- if .HasMachine}}
	if e.scopeMachine != nil {
		return d.withinMachine(ctx, e.scopeMachine, mode, run)
	}
{{end}}
	if d.scopeDBPool == nil || e.scopeExecution == nil ||
		e.scopeGate == nil || run == nil {
		return ErrNoTenant
	}

	tenant := e.scopeExecution.TenantID()

	return e.scopeGate.Use(
		ctx,
		e.scopeExecution,
		tenant,
		e.scopeResource,
		func(ctx context.Context) error {
			return d.transact(
				ctx,
				mode,
				Tenant{scopeTenant: tenant},
				e.scopeExecution.SubjectID(),
				run,
			)
		},
	)
}

func (d DB) transact(
	ctx context.Context,
	mode pgx.TxAccessMode,
	tenant Tenant,
	subject string,
	run func(context.Context, Tx) error,
) (err error) {
	tx, err := d.scopeDBPool.BeginTx(ctx, pgx.TxOptions{AccessMode: mode})
	if err != nil {
		return err
	}

	// Rollback after Commit is a no-op, so every exit, including a panic in
	// run, releases the transaction.
	defer func() {
		_ = tx.Rollback(context.WithoutCancel(ctx))
	}()

	if _, err = tx.Exec(
		ctx,
		"SELECT set_config('app.tenant_id', $1, true)",
		tenant.scopeTenant,
	); err != nil {
		return err
	}

	if err = run(ctx, Tx{
		scopeTx:      tx,
		scopeTenant:  tenant,
		scopeSubject: subject,
		scopeJobs:    d.scopeDBJobs,
	}); err != nil {
		return err
	}

	return tx.Commit(ctx)
}

// Queries binds an sqlc constructor to the transaction. Only the generated
// per-group queriesOf helper may call it; authored adapters call queriesOf(tx).
// It panics when the constructor does not take a pgx-compatible DBTX, which
// sqlc's pgx/v5 output always does.
func Queries[Q, D any](t Tx, constructor func(D) Q) Q {
	db, ok := any(t.scopeTx).(D)
	if !ok || t.scopeTx == nil {
		panic("scope: sqlc constructor does not accept a pgx transaction")
	}

	return constructor(db)
}

// NoRows reports an empty single-row result.
func NoRows(err error) bool {
	return errors.Is(err, pgx.ErrNoRows)
}

// ErrUnknownJob rejects an Enqueue of a kind no [[jobs]] entry declares.
var ErrUnknownJob = errors.New("scope: job kind is not declared")

// enqueueAttempts maps every declared job kind to its declared, finite
// delivery budget. Authored code can neither add a kind nor choose a budget.
var enqueueAttempts = map[string]int{
{{- range .Manifest.Jobs}}
	{{q .Kind}}: {{.MaxAttempts}},
{{- end}}
}

// Enqueue inserts a declared job in this transaction, so it exists if and only
// if the business change commits. kind must be a declared [[jobs]] kind and
// payload valid JSON for that job's request model; the delivery's tenant is
// this transaction's verified tenant, never an argument, and its attempt
// budget is the declared one. The worker authenticates its configured service
// credential for the tenant when it delivers, so an enqueue grants nothing.
func (t Tx) Enqueue(ctx context.Context, kind string, payload []byte) error {
	attempts, declared := enqueueAttempts[kind]
	if !declared {
		return ErrUnknownJob
	}

	if t.scopeTx == nil || t.scopeJobs == nil ||
		t.scopeTenant.scopeTenant == "" {
		return ErrNoTenant
	}

	tenant := t.scopeTenant.scopeTenant

	request, err := jobs.NewRequest(
		jobs.Kind(kind),
		json.RawMessage(payload),
		jobs.Options{
			TenantID:    &tenant,
			AvailableAt: time.Now().UTC(),
			MaxAttempts: attempts,
		})
	if err != nil {
		return err
	}

	return t.scopeJobs.EnqueueTx(ctx, t.scopeTx, request)
}

// Bind is a capability: only generated workflow files and the scope test
// harness may call it. It attaches a callback-scoped execution and its gate.
func Bind(
	execution *identitygate.Execution,
	gate *identitygate.Gate,
	resource string,
) Execution {
	return Execution{
		scopeExecution: execution,
		scopeGate:      gate,
		scopeResource:  resource,
	}
}

// NewDB is a capability: only generated composition may call it.
func NewDB(pool *pgxpool.Pool) DB {
	// A nil pool yields no store; Enqueue then reports ErrNoTenant.
	store, _ := jobspostgres.New(pool)

	return DB{scopeDBPool: pool, scopeDBJobs: store}
}
{{if .HasProvision}}
// ErrProvisioned rejects a second tenant in one provisioning execution.
var ErrProvisioned = errors.New("scope: provisioning already used")

// Provisioning is the identity of a tenant-less provisioning request: a
// verified subject with no tenant and no membership yet. It has no
// constructor, the zero value denies, it is valid only inside its generated
// workflow, and it provisions at most one tenant.
type Provisioning struct {
	scopeProvision *provisionState
}

type provisionState struct {
	mutex    sync.Mutex
	manager  *auth.Manager
	identity *auth.Identity
	subject  string
	used     bool
}

// SubjectID is the verified subject that becomes the new tenant's first
// member. Never take it from request input.
func (p Provisioning) SubjectID() string {
	if p.scopeProvision == nil {
		return ""
	}

	return p.scopeProvision.subject
}

// Provision rechecks the live session, mints a new tenant identifier, opens
// one read-write transaction and binds app.tenant_id to the NEW tenant. The
// transaction's Tenant is the only tenant authored code can name, and forced
// row-level security rejects any row for another tenant, so a provisioning
// body can create a tenant root and its first rows but can never write into
// an existing tenant. It runs once per Provisioning.
func (d DB) Provision(
	ctx context.Context,
	p Provisioning,
	run func(context.Context, Tx) error,
) error {
	state := p.scopeProvision
	if d.scopeDBPool == nil || state == nil || state.manager == nil ||
		state.identity == nil || run == nil {
		return ErrNoTenant
	}

	state.mutex.Lock()

	if state.used {
		state.mutex.Unlock()

		return ErrProvisioned
	}

	state.used = true
	state.mutex.Unlock()

	return state.manager.UseIdentity(
		ctx,
		state.identity,
		func(ctx context.Context, subject string) error {
			if subject != state.subject {
				return auth.ErrUnauthenticated
			}

			tenant, err := newTenantID()
			if err != nil {
				return err
			}

			return d.transact(
				ctx,
				pgx.ReadWrite,
				Tenant{scopeTenant: tenant},
				state.subject,
				run,
			)
		},
	)
}

// newTenantID mints a random version 4 UUID.
func newTenantID() (string, error) {
	var raw [16]byte
	if _, err := rand.Read(raw[:]); err != nil {
		return "", err
	}

	raw[6] = raw[6]&0x0f | 0x40
	raw[8] = raw[8]&0x3f | 0x80
	encoded := hex.EncodeToString(raw[:])

	return encoded[0:8] + "-" + encoded[8:12] + "-" + encoded[12:16] + "-" +
		encoded[16:20] + "-" + encoded[20:], nil
}

// BindProvisioning is a capability: only a generated provisioning workflow
// may call it. The manager and identity are callback-scoped, so the value
// cannot outlive its request.
func BindProvisioning(
	manager *auth.Manager,
	identity *auth.Identity,
	subject string,
) Provisioning {
	return Provisioning{scopeProvision: &provisionState{
		manager:  manager,
		identity: identity,
		subject:  subject,
	}}
}
{{end}}{{if .HasMachine}}
// withinMachine opens a tenant transaction for a verified machine. The live
// recheck runs inside the transaction before the body's first statement: a
// machine revoked or re-keyed since verification is denied.
func (d DB) withinMachine(
	ctx context.Context,
	verified *machineauth.Verified,
	mode pgx.TxAccessMode,
	run func(context.Context, Tx) error,
) error {
	if d.scopeDBPool == nil || verified == nil || run == nil ||
		verified.TenantID() == "" {
		return ErrNoTenant
	}

	tenant := Tenant{scopeTenant: verified.TenantID()}

	tx, err := d.scopeDBPool.BeginTx(ctx, pgx.TxOptions{AccessMode: mode})
	if err != nil {
		return err
	}

	defer func() {
		_ = tx.Rollback(context.WithoutCancel(ctx))
	}()

	if _, err = tx.Exec(
		ctx,
		"SELECT set_config('app.tenant_id', $1, true)",
		tenant.scopeTenant,
	); err != nil {
		return err
	}

	if err = machinestore.Recheck(ctx, tx, *verified); err != nil {
		return err
	}

	if err = run(ctx, Tx{
		scopeTx:      tx,
		scopeTenant:  tenant,
		scopeSubject: verified.MachineID(),
	}); err != nil {
		return err
	}

	return tx.Commit(ctx)
}

// BindMachine is a capability: only generated machine workflows may call it.
// The verified machine becomes the Execution of the body: its subject is the
// machine id and its tenant is the tenant of the machine row.
func BindMachine(verified machineauth.Verified, resource string) Execution {
	return Execution{scopeMachine: &verified, scopeResource: resource}
}

// IssueEnrollment mints a single-use enrollment token for a pending machine
// row of this transaction's tenant, returned once. Call it in the same
// write transaction that creates the pending row.
func (t Tx) IssueEnrollment(
	ctx context.Context,
	principal, machineID string,
) (string, time.Time, error) {
	if t.scopeTx == nil || t.scopeTenant.scopeTenant == "" {
		return "", time.Time{}, ErrNoTenant
	}

	return machinestore.IssueEnrollment(
		ctx,
		t.scopeTx,
		t.scopeTenant.scopeTenant,
		principal,
		machineID,
	)
}

// RevokeMachine moves a pending or active machine of this transaction's
// tenant to the revoked state: its next request is denied. Authored SQL may
// not write the key or state columns; this is the revocation path.
func (t Tx) RevokeMachine(ctx context.Context, principal, machineID string) error {
	if t.scopeTx == nil || t.scopeTenant.scopeTenant == "" {
		return ErrNoTenant
	}

	return machinestore.RevokeMachine(
		ctx,
		t.scopeTx,
		t.scopeTenant.scopeTenant,
		principal,
		machineID,
	)
}

// RotateMachine clears the machine's key, which stops it authenticating at
// once, and returns a new single-use enrollment token (once) for its next
// key. A revoked machine cannot be rotated.
func (t Tx) RotateMachine(
	ctx context.Context,
	principal, machineID string,
) (string, time.Time, error) {
	if t.scopeTx == nil || t.scopeTenant.scopeTenant == "" {
		return "", time.Time{}, ErrNoTenant
	}

	return machinestore.RotateMachine(
		ctx,
		t.scopeTx,
		t.scopeTenant.scopeTenant,
		principal,
		machineID,
	)
}
{{end}}