package {{.Group}}

import (
	"context"

	logic "{{.Module}}/internal/logic/{{.Group}}"
	models "{{.Module}}/internal/models/{{.Group}}"
	"{{.Module}}/internal/scope"
	identitygate "github.com/plutoframework/pluto-rbac/identity"
{{- if .Authored.Pagination}}
	"github.com/plutoframework/pluto-core/pagination"
{{- end}}
)

// execute is the only caller of the authored body. It binds the
// callback-scoped execution to this operation's gate and fixed resource, so
// every data access the body makes revalidates identity, membership,
// permission and resource policy.
func (operation *{{.Action}}) execute(
	ctx context.Context,
	execution *identitygate.Execution,
	request models.{{.Action}}Request,
) ({{.Authored.Returns}}) {
	return logic.{{.Action}}(
		ctx,
		scope.Bind(
			execution,
			operation.{{lowerFirst .Action}}Gate,
			{{q .Authored.Resource}}),
		operation.{{lowerFirst .Action}}Ports,
		request)
}
