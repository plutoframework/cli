 if ctx==nil||operation==nil{return {{.Action}}Dependencies{},agent.ErrDenied}
 intent,err:=operation.Prepare(ctx,caller,input)
 if err!=nil{return {{.Action}}Dependencies{},err}
 return {{.Action}}Dependencies{ {{lowerFirst .Action}}Operation:operation,{{lowerFirst .Action}}Intent:intent},nil
}

