  return d.{{lowerFirst .Action}}Operation.AuthorizeIntent(ctx,d.{{lowerFirst .Action}}Intent)
 }
 tool,err:=agent.NewTool(agent.ToolConfig[{{.Action}}Dependencies,{{.Action}}Arguments,models.{{.OperationAction}}Data]{
  Name:"execute_approved_operation",Description:"Execute only the exact operation intent approved by the host.",
  Access:agent.Access{Permission:{{q .Permission}}},Effect:{{if .Contract.Kind}}{{if or (eq .Contract.Kind "create") (eq .Contract.Kind "transition")}}agent.SideEffect{{else}}agent.ReadOnly{{end}}{{else}}agent.ReadOnly{{end}},
  Policy:func(ctx context.Context,d {{.Action}}Dependencies,actor agent.Actor,_ {{.Action}}Arguments)error{
   current,err:=authorize(ctx,d)
   if err!=nil||actor.SubjectID!=current.SubjectID||actor.Scope!=current.TenantID{return agent.ErrDenied};return nil
  },
  Handle:func(ctx context.Context,d {{.Action}}Dependencies,_ {{.Action}}Arguments)(models.{{.OperationAction}}Data,error){
   if d.{{lowerFirst .Action}}Receipt==nil||d.{{lowerFirst .Action}}Receipt.applied{return models.{{.OperationAction}}Data{},agent.ErrDenied}
   output,err:=d.{{lowerFirst .Action}}Operation.ExecutePrepared(ctx,d.{{lowerFirst .Action}}Intent)
   if err==nil{if output.JobIDs==nil{output.JobIDs=[]string{}};d.{{lowerFirst .Action}}Receipt.output=output;d.{{lowerFirst .Action}}Receipt.applied=true}
   return output,err
  },
 })
 if err!=nil{return nil,err}
 limits:=agent.DefaultLimits();limits.MaxModelCalls=2;limits.MaxToolCalls=1;limits.MaxRepairs=0
 limits.RunTimeout=10*time.Second;limits.ModelTimeout=4*time.Second;limits.ToolTimeout=time.Second
 return agent.New(agent.Config[{{.Action}}Dependencies,{{.Action}}Review]{Provider:provider,Limits:limits,Tools:[]agent.Tool[{{.Action}}Dependencies]{tool},
 Instructions:"Execute the host-approved operation once, then summarize its verified tool result. Never invent completion or change resources.",
 Principal:func(d {{.Action}}Dependencies)(agent.Actor,error){
  current,err:=authorize(d.{{lowerFirst .Action}}Context,d);if err!=nil{return agent.Actor{},err}
  return agent.Actor{SubjectID:current.SubjectID,Scope:current.TenantID},nil
 },Authorizer:agent.AuthorizerFunc(func(_ context.Context,_ agent.Actor,permission string)error{if permission!={{q .Permission}}{return agent.ErrDenied};return nil}),
 })
}

