    missingTenant.TenantID = nil
    if err := Handle{{.Action}}(context.Background(), missingTenant); !errors.Is(err, jobs.ErrInvalid) {
        t.Fatal("missing tenant accepted", err)
    }
    if _, err := New{{.Action}}({{.Action}}Payload{ResourceID: "resource"}, jobs.Options{}); !errors.Is(err, jobs.ErrInvalid) {
        t.Fatal("unscoped producer accepted", err)
    }
    {{end}}
    if err := Handle{{.Action}}(context.Background(), job); !errors.Is(err, Err{{.Action}}Unimplemented) {
