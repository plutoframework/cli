package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/access"
	"{{.Module}}/internal/config"
	"{{.Module}}/internal/caching"
	"{{.Module}}/internal/storage/postgres"
	"{{.Module}}/internal/transport"
{{if not .LocalCredentials}}plutoauth "github.com/plutoframework/pluto-auth"{{end}}
{{if not .LocalCredentials}}authmemory "github.com/plutoframework/pluto-auth/stores/memory"{{end}}
{{if not .LocalCredentials}}authpostgres "github.com/plutoframework/pluto-auth/stores/postgres"{{end}}
 "github.com/plutoframework/pluto-core/idempotency"
 "github.com/plutoframework/pluto-core/httpidem"
 idempostgres "github.com/plutoframework/pluto-core/stores/postgres"
)

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}

	policy, err := access.NewPolicy()
	if err != nil {
		return err
	}

	var level slog.Level
	if err := level.UnmarshalText([]byte(cfg.Logging.Level)); err != nil {
		return err
	}

	logger := slog.New(
		slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: level}),
	)
    dataCache, closeCache, err := caching.New(cfg.Cache)
    if err != nil { return errors.New("invalid cache configuration") }
    defer closeCache()

	ctx, stop := signal.NotifyContext(
		context.Background(),
		os.Interrupt,
		syscall.SIGTERM,
	)
	defer stop()

	{{if .LocalCredentials}}
    var authentication transport.Authentication
    {{else}}
    var sessionStore plutoauth.SessionStore
    {{end}}
 startup,cancelStartup:=context.WithTimeout(ctx,10*time.Second)
    defer cancelStartup()
    var idempotencyStore idempotency.Store
 if cfg.Database.URL != "" {
		pool, err := postgres.Open(startup, cfg.Database.URL)
		if err != nil {
			return errors.New("postgres connectivity failed; verify DATABASE_URL and database availability")
		}
		defer pool.Close()
        idempotencyStore,err=idempostgres.New(pool)
 if err!=nil {return err}
 {{if .LocalCredentials}}
        authentication,err=newLocalAuthentication(startup,cfg,pool)
        {{else}}
        sessionStore,err=authpostgres.New(pool)
        {{end}}
        if err != nil { return err }
    }{{if not .LocalCredentials}} else {
        sessionStore,err=authmemory.New(1000)
        if err != nil { return err }
    }
    {{end}}
    var idempotent *httpidem.Handler
 if idempotencyStore!=nil { idempotent,err=transport.NewIdempotency(idempotencyStore,cfg.Server.BodyLimit);if err!=nil{return err} }
 {{if not .LocalCredentials}}
    authentication,err:=transport.NewAuthentication(cfg.Auth,sessionStore,access.Memberships{})
    if err != nil { return err }
    {{end}}
 authentication.Idempotency=idempotent

	server := &http.Server{
		Addr:              cfg.Server.Address,
		Handler:           app.NewWithCache(cfg, authentication, logger, policy, dataCache),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       cfg.Server.ReadTimeout,
		WriteTimeout:      cfg.Server.WriteTimeout,
		IdleTimeout:       cfg.Server.IdleTimeout,
		MaxHeaderBytes:    16 * 1024,
	}
	done := make(chan struct{})

	go func() {
		select {
		case <-ctx.Done():
			shutdown, cancel := context.WithTimeout(
				context.Background(),
				10*time.Second,
			)
			defer cancel()

			if err := server.Shutdown(shutdown); err != nil {
				logger.Error("shutdown failed")
			}
		case <-done:
		}
	}()

	defer close(done)

	logger.Info(
		"listening",
		"address",
		server.Addr,
		"authentication",
		"pluto-sessions; membership denies until implemented",
	)

	err = server.ListenAndServe()
	if errors.Is(err, http.ErrServerClosed) {
		return nil
	}

	return err
}

func main() {
	if err := run(); err != nil {
		// Database driver errors are sanitized at their boundary above.
  slog.Error("startup/server failed","error",err)

		os.Exit(1)
	}
}
