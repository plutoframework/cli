package {{.Group}}

import (
	"context"

	commonDomain "{{.Module}}/internal/domain"
	logic "{{.Module}}/internal/logic/{{.Group}}"
	models "{{.Module}}/internal/models/{{.Group}}"
	auth "github.com/plutoframework/pluto-auth"
)

// {{.Action}}Limiter is the shared, replica-wide attempt limiter. It fails
// closed.
type {{.Action}}Limiter interface {
	Allow(context.Context, string) error
}

type {{.Action}}Boundary interface {
	sealed{{.Action}}()
	Execute(
		context.Context,
		*auth.Identity,
		models.{{.Action}}Request) (models.{{.Action}}Data, error)
}

// {{.Action}} provisions a new tenant for a verified identity that need not
// belong to any tenant yet. There is no membership, permission or resource
// check because none can exist before the tenant does: the session is
// verified live, the attempt is rate limited per subject, and the authored
// body logic.{{.Action}} receives a Provisioning that mints exactly one new
// tenant. The body is reachable only from this generated gate.
type {{.Action}} struct {
	{{lowerFirst .Action}}Manager *auth.Manager
	{{lowerFirst .Action}}Limiter {{.Action}}Limiter
	{{lowerFirst .Action}}Ports   logic.{{.Action}}Ports
}

func New{{.Action}}(
	manager *auth.Manager,
	limiter {{.Action}}Limiter,
	ports logic.{{.Action}}Ports,
) *{{.Action}} {
	return &{{.Action}}{
		{{lowerFirst .Action}}Manager: manager,
		{{lowerFirst .Action}}Limiter: limiter,
		{{lowerFirst .Action}}Ports:   ports,
	}
}

func (*{{.Action}}) sealed{{.Action}}() {}

func (operation *{{.Action}}) Execute(
	ctx context.Context,
	identity *auth.Identity,
	input models.{{.Action}}Request,
) (models.{{.Action}}Data, error) {
	var output models.{{.Action}}Data

	if ctx == nil || operation == nil || identity == nil ||
		operation.{{lowerFirst .Action}}Manager == nil ||
		operation.{{lowerFirst .Action}}Limiter == nil {
		return output, commonDomain.ErrUnauthenticated
	}
{{- if .Manifest.DeviceOn}}

	// A delegated client never creates tenants: provisioning needs the
	// owner's own interactive session.
	if _, delegated := identity.Delegation(); delegated {
		return output, commonDomain.ErrForbidden
	}
{{- end}}

	err := operation.{{lowerFirst .Action}}Manager.UseIdentity(
		ctx,
		identity,
		func(ctx context.Context, subject string) error {
			if err := operation.{{lowerFirst .Action}}Limiter.Allow(
				ctx,
				{{q .Authored.ID}}+":"+subject); err != nil {
				return err
			}

			var err error

			output, err = operation.execute(
				ctx,
				identity,
				subject,
				input)

			return err
		})
	if err != nil {
		return models.{{.Action}}Data{}, err
	}

	return output, nil
}
