// Package paths owns the runtime catalog derived from pluto.toml.
package paths

import (
	"time"

	rbac "github.com/plutoframework/pluto-rbac"
)

type Endpoint struct {
	Collection    bool
	Idempotent    bool
	ID            string
	Name          string
	Description   string
	Method        string
	Path          string
	Authenticated bool
	SessionOnly   bool
{{- if .HasMachine}}

	// Machine names the principal of a machine-authenticated endpoint: it
	// carries no user session and no user permission.
	Machine string
{{- end}}
	Permission    rbac.PermissionID
	Feature       string
	Request       any
	Response      any
	SuccessStatus int
	Query         []QueryParam
	Params        []PathParam
{{- if .HasStream}}
	Stream        *StreamSpec
{{- end}}
}
{{if .HasStream}}
// StreamSpec describes a WebSocket endpoint: the JSON message models in each
// direction and the generated limits the stream runtime enforces.
type StreamSpec struct {
	Server          any
	Client          any
	MaxMessageBytes int
	Origins         []string
}
{{end}}

// QueryParam is one declared typed query parameter of an authored read.
type QueryParam struct {
	Name  string
	Type  string
	Max   int
	After string
}

// PathParam is one declared typed path parameter of an authored endpoint.
type PathParam struct {
	Name string
	Type string
	Max  int
}

type FeaturesResponse struct {
	Data map[string]bool `json:"data"`
}
type HealthResponse struct {
	Data string `json:"data"`
}

var GetFeatures = Endpoint{
	ID:            "features.get",
	Name:          "Read visible feature flags",
	Description:   "Authenticated allowlist; flags do not grant " +
		"authorization.",
	Method:        "GET",
	Path:          "/api/features",
	Authenticated: true,
	Response:      FeaturesResponse{},
	SuccessStatus: 200,
}

var Health = Endpoint{
	ID:            "health.get",
	Name:          "Liveness",
	Description:   "Process liveness; does not claim database readiness.",
	Method:        "GET",
	Path:          "/healthz",
	Response:      HealthResponse{},
	SuccessStatus: 200,
}

type Session struct {
	ID        string    `json:"id"`
	ActorID   string    `json:"actor_id"`
	ExpiresAt time.Time `json:"expires_at"`
}

type SessionResponse struct {
	Data Session `json:"data"`
}
type SignedOutResponse struct {
	Data bool `json:"data"`
}

var GetSession = Endpoint{
	ID:            "sessions.get",
	Name:          "Read current session",
	Description:   "Read verified session metadata without selecting a " +
		"tenant.",
	Method:        "GET",
	Path:          "/auth/session",
	Authenticated: true,
	SessionOnly:   true,
	Response:      SessionResponse{},
	SuccessStatus: 200,
}

var DeleteSession = Endpoint{
	ID:            "sessions.delete",
	Name:          "Sign out",
	Description:   "Revoke this session before clearing its cookie; no " +
		"tenant membership is required.",
	Method:        "DELETE",
	Path:          "/auth/session",
	Authenticated: true,
	SessionOnly:   true,
	Response:      SignedOutResponse{},
	SuccessStatus: 200,
}
