// Package paths owns the runtime catalog derived from pluto.toml.
package paths

import (rbac "github.com/plutoframework/pluto-rbac";"time")

type Endpoint struct {
	ID            string
	Name          string
	Description   string
	Method        string
	Path          string
	Authenticated bool
 SessionOnly bool
	Permission    rbac.PermissionID
	Feature       string
	Request       any
	Response      any
	SuccessStatus int
}

type FeaturesResponse struct {
	Data map[string]bool `json:"data"`
}
type HealthResponse struct {
	Data string `json:"data"`
}

var GetFeatures = Endpoint{
	ID:            "features.get",
	Name:          "Read visible feature flags",
	Description:   "Authenticated allowlist; flags do not grant authorization.",
	Method:        "GET",
	Path:          "/api/features",
	Authenticated: true,
	Response:      FeaturesResponse{},
	SuccessStatus: 200,
}

var Health = Endpoint{
	ID:            "health.get",
	Name:          "Liveness",
	Description:   "Process liveness; does not claim database readiness.",
	Method:        "GET",
	Path:          "/healthz",
	Response:      HealthResponse{},
	SuccessStatus: 200,
}

type Session struct {
    ID string `json:"id"`
    ActorID string `json:"actor_id"`
    ExpiresAt time.Time `json:"expires_at"`
}

type SessionResponse struct { Data Session `json:"data"` }
type SignedOutResponse struct { Data bool `json:"data"` }

var GetSession = Endpoint{
    ID:"sessions.get",Name:"Read current session",
    Description:"Read verified session metadata without selecting a tenant.",
    Method:"GET",Path:"/auth/session",Authenticated:true,SessionOnly:true,
    Response:SessionResponse{},SuccessStatus:200,
}

var DeleteSession = Endpoint{
    ID:"sessions.delete",Name:"Sign out",
    Description:"Revoke this session before clearing its cookie; no tenant membership is required.",
    Method:"DELETE",Path:"/auth/session",Authenticated:true,SessionOnly:true,
    Response:SignedOutResponse{},SuccessStatus:200,
}
