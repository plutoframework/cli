package {{.Group}}

import (
	"context"
	"errors"

	commonDomain "{{.Module}}/internal/domain"
	models "{{.Module}}/internal/models/{{.Group}}"
)

// Err{{.Action}}NotFound reports a key that resolves to no row.
var Err{{.Action}}NotFound = errors.New("{{.Authored.ID}}: not found")

// {{.Action}}Reader is the generated, read-only lookup of {{.Lookup.ID}}.
type {{.Action}}Reader interface {
	Read(context.Context, string) (models.{{.Action}}Data, bool, error)
}

// {{.Action}}Limiter is the shared, replica-wide attempt limiter. It fails
// closed.
type {{.Action}}Limiter interface {
	Allow(context.Context, string) error
}

type {{.Action}}Boundary interface {
	sealed{{.Action}}()
	Execute(
		context.Context,
		string,
		models.{{.Action}}Request) (models.{{.Action}}Data, error)
}

// {{.Action}} is the public, generated, rate-limited resolution of one
// {{.Lookup.Table}} row by {{.Lookup.Key}}. It returns only the declared
// columns and has no authored body.
type {{.Action}} struct {
	{{lowerFirst .Action}}Reader  {{.Action}}Reader
	{{lowerFirst .Action}}Limiter {{.Action}}Limiter
}

func New{{.Action}}(
	reader {{.Action}}Reader,
	limiter {{.Action}}Limiter,
) *{{.Action}} {
	return &{{.Action}}{
		{{lowerFirst .Action}}Reader:  reader,
		{{lowerFirst .Action}}Limiter: limiter,
	}
}

func (*{{.Action}}) sealed{{.Action}}() {}

// Execute rate limits by the caller-supplied client key, never by the lookup
// key, so an attacker cannot reset the limit by varying the key.
func (operation *{{.Action}}) Execute(
	ctx context.Context,
	clientKey string,
	input models.{{.Action}}Request,
) (models.{{.Action}}Data, error) {
	var output models.{{.Action}}Data

	if ctx == nil || operation == nil || clientKey == "" ||
		operation.{{lowerFirst .Action}}Reader == nil ||
		operation.{{lowerFirst .Action}}Limiter == nil {
		return output, commonDomain.ErrUnauthenticated
	}

	if input.{{.KeyGoName}} == "" {
		return output, commonDomain.ErrInvalidInput
	}

	if err := operation.{{lowerFirst .Action}}Limiter.Allow(
		ctx,
		{{q .Authored.ID}}+":"+clientKey); err != nil {
		return output, err
	}

	output, found, err := operation.{{lowerFirst .Action}}Reader.Read(
		ctx,
		input.{{.KeyGoName}})
	if err != nil {
		return models.{{.Action}}Data{}, err
	}

	if !found {
		return models.{{.Action}}Data{}, Err{{.Action}}NotFound
	}

	return output, nil
}
