package {{.Group}}

import (
	"context"
	"errors"
	"testing"

	"{{.Module}}/internal/access"
	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/models/{{.Group}}"

	rbac "github.com/plutoframework/pluto-rbac"
)

type membership{{.Action}} struct{}

func (membership{{.Action}}) Resolve(
	_ context.Context,
	subject string,
{{if .Multi}}
	tenant string,
{{end}}
) (domain.Principal, error) {
	return domain.Principal{
		ActorID: subject,
{{if .Multi}}
		TenantID: tenant,
{{end}}
		 Roles: []rbac.RoleID{"test-caller"},
	}, nil
}

func Test{{.Action}}Incomplete(t *testing.T) {
	grants := []rbac.PermissionID{}
{{if .Permission}}

	grants = append(grants, access.{{.Symbol}}Permission)
{{end}}

	policy, err := rbac.New(rbac.Definition{
		Permissions: access.Permissions(),
		Roles: []rbac.Role{
			{
				ID:          "test-caller",
				Name:        "Test caller",
				Description: "Test-only capability grants.",
				Permissions: grants,
			},
		},
	})
	if err != nil {
		t.Fatal(err)
	}

	resolvedRoles := []rbac.RoleID{"test-caller"}

	authorizer, err := rbac.NewAuthorizer(
		policy,
		rbac.RoleResolverFunc(
			func(context.Context, string, rbac.Scope) ([]rbac.RoleID, error) {
				return resolvedRoles, nil
			}),
		rbac.Options{RequireTenant: {{.Multi}}})
	if err != nil {
		t.Fatal(err)
	}

	operation := New{{.Action}}(authorizer, membership{{.Action}}{})
	principal := domain.Principal{
		ActorID: "test-actor",
{{if .Multi}}

		TenantID: "test-tenant",
{{end}}

		Roles: []rbac.RoleID{"test-caller"},
	}
	input := {{.Group}}.{{.Action}}Request{Value: "must not succeed"}

	output, err := operation.Execute(context.Background(), principal, input)
	if !errors.Is(
		err, domain.ErrNotImplemented){{if not .Collection}} ||
		output.Value != ""{{end}} {
		t.Fatalf("incomplete operation returned %#v, %v", output, err)
	}
{{if not .Public}}
	_, err = operation.Execute(context.Background(), domain.Principal{}, input)
	if !errors.Is(err, domain.ErrUnauthenticated) {
		t.Fatalf("unauthenticated direct operation call: %v", err)
	}
{{end}}
{{if .Permission}}
	resolvedRoles = nil
	principal.Roles = []rbac.RoleID{"test-caller"}

	_, err = operation.Execute(context.Background(), principal, input)
	if !errors.Is(err, domain.ErrForbidden) {
		t.Fatalf("missing grants reached incomplete operation: %v", err)
	}

	resolvedRoles = []rbac.RoleID{"test-caller", "unknown-role"}

	_, err = operation.Execute(context.Background(), principal, input)
	if !errors.Is(err, domain.ErrForbidden) {
		t.Fatalf("unknown role retained partial grants: %v", err)
	}
{{end}}
}
